{%- comment -%}
  Pattern service row: up to 4 service notes on the paper background. Each column has a thick
  charcoal rule on top, an optional line icon (snippets/pattern-icon.liquid), a small mono label
  ("Postage · PT & ES"), a bold display highlight, one line of supporting text and an arrow link
  pinned to the foot of the column so links line up across columns. With a link the whole column is the link: on hover
  the link text underlines and the arrow nudges right and turns Opal.

  Background: the same setting and classes as the Pattern column block (paper, clay, clay stripes,
  dark stripes). Text, icons (currentColor), rules and links take --service-fg / --service-muted,
  which flip to paper tints on the dark background.
{%- endcomment -%}
{%- liquid
  assign bg = section.settings.background | default: 'paper'
  assign texture_class = ''
  if bg == 'stripes-dark'
    assign texture_class = ' pattern-stripe-dark'
  elsif bg == 'stripes-clay'
    assign texture_class = ' pattern-stripe-clay'
  endif
-%}
{%- style -%}
  #shopify-section-{{ section.id }} .pattern-service {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pattern-service {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <section
    class="pattern-section pattern-service pattern-service--bg-{{ bg }}{{ texture_class }}"
    {% if section.settings.heading != blank %}
      aria-labelledby="PatternServiceHeading-{{ section.id }}"
    {% else %}
      aria-label="Services"
    {% endif %}
  >
    <div class="pattern-wrap pattern-service__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="pattern-label pattern-service__heading" id="PatternServiceHeading-{{ section.id }}">
          {{- section.settings.heading | escape -}}
        </h2>
      {%- endif -%}

      <ul class="pattern-service__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_tag = 'div'
            if block.settings.link != blank
              assign item_tag = 'a'
            endif
          -%}
          <li class="pattern-service__cell" {{ block.shopify_attributes }}>
            <{{ item_tag }}
              class="pattern-service__item{% if item_tag == 'a' %} pattern-service__item--link{% endif %}"
              {% if item_tag == 'a' %}
                href="{{ block.settings.link }}"
              {% endif %}
            >
              {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                {% render 'pattern-icon', name: block.settings.icon, class: 'pattern-service__icon' %}
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span class="pattern-label pattern-service__label">{{ block.settings.label | escape }}</span>
              {%- endif -%}
              {%- if block.settings.highlight != blank -%}
                <span class="pattern-service__highlight">{{ block.settings.highlight | escape }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <span class="pattern-service__text">{{ block.settings.text | escape }}</span>
              {%- endif -%}
              {%- if item_tag == 'a' -%}
                <span class="pattern-service__more">
                  <span class="pattern-service__more-label">{{ block.settings.link_label | default: 'Details' | escape }}</span>
                  {% render 'pattern-arrow' %}
                </span>
              {%- endif -%}
            </{{ item_tag }}>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  /* Backgrounds (as blocks/pattern-column.liquid) */
  .pattern-service {
    --service-fg: var(--pattern-ink);
    --service-muted: var(--pattern-muted);
    color: var(--service-fg);
  }

  .pattern-service--bg-paper {
    --pattern-surface: var(--pattern-paper);
    background-color: var(--pattern-paper);
  }

  .pattern-service--bg-clay,
  .pattern-service--bg-stripes-clay {
    --pattern-surface: var(--pattern-clay);
    background-color: var(--pattern-clay);
  }

  .pattern-service--bg-stripes-dark {
    --pattern-surface: var(--pattern-ink);
    --service-fg: var(--pattern-paper);
    --service-muted: var(--pattern-paper-dim);
    background-color: var(--pattern-ink);
  }

  .pattern-service__inner {
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }

  .pattern-service__heading {
    color: var(--service-muted);
  }

  .pattern-service__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr));
    gap: 4rem 3.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pattern-service__cell {
    display: flex;
    min-width: 0;
  }

  .pattern-service__item {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding-top: 2.8rem;
    border-top: 0.3rem solid var(--service-fg);
    color: var(--service-fg);
    text-decoration: none;
  }

  /* Icon: under the rule, above the label, ~20px below it (8px margin + the 12px column gap) */
  .pattern-service__icon {
    flex: 0 0 auto;
    display: block;
    margin-bottom: 0.8rem;
    color: var(--service-fg);
  }

  .pattern-service__label {
    color: var(--service-muted);
  }

  .pattern-service__highlight {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 2.7vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    overflow-wrap: break-word;
  }

  .pattern-service__text {
    font-size: 1.6rem;
    line-height: 1.5;
    color: var(--service-muted);
  }

  .pattern-service__more {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 0.4rem;
    min-height: 4.4rem;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .pattern-service__more .pattern-arrow {
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .pattern-service__item--link:hover .pattern-service__more-label,
  .pattern-service__item--link:focus-visible .pattern-service__more-label {
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  /* Arrow: nudges right and turns Opal (3.1:1 on paper, fine for a graphic) */
  .pattern-service__item--link:hover .pattern-arrow,
  .pattern-service__item--link:focus-visible .pattern-arrow {
    transform: translateX(0.4rem);
    color: var(--pattern-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .pattern-service__more .pattern-arrow {
      transition: none;
    }

    .pattern-service__item--link:hover .pattern-arrow,
    .pattern-service__item--link:focus-visible .pattern-arrow {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pattern service row",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional small label above the columns."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "stripes-dark", "label": "Stripes, dark" },
        { "value": "stripes-clay", "label": "Stripes, clay" },
        { "value": "clay", "label": "Clay" },
        { "value": "paper", "label": "Paper" }
      ],
      "default": "paper"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "parcel", "label": "Parcel" },
            { "value": "storefront", "label": "Storefront" },
            { "value": "clock", "label": "Clock" },
            { "value": "bike", "label": "Bike" },
            { "value": "van", "label": "Van" },
            { "value": "disc", "label": "Disc (record)" },
            { "value": "headphones", "label": "Headphones" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "swap", "label": "Swap (exchange)" }
          ],
          "default": "parcel"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Small mono line, e.g. \"Postage · PT & ES\".",
          "default": "Postage · PT & ES"
        },
        {
          "type": "text",
          "id": "highlight",
          "label": "Highlight",
          "default": "One flat rate"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "To Portugal and Spain."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "With a link the whole column is clickable. The link row hides when this is empty."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link text",
          "default": "Details"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pattern service row",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "parcel",
            "label": "Postage · PT & ES",
            "highlight": "One flat rate",
            "text": "To Portugal and Spain.",
            "link_label": "Shipping details"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "storefront",
            "label": "Collect · Alcântara",
            "highlight": "Collect in store",
            "text": "Pick up at the shop and have a listen while you're there.",
            "link_label": "How collection works"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "clock",
            "label": "Delivery · Lisbon",
            "highlight": "Lisbon in 24 hours",
            "text": "Flat-fee delivery within Lisbon postcodes.",
            "link_label": "Delivery zones"
          }
        }
      ]
    }
  ]
}
{% endschema %}
