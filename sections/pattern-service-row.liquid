{%- comment -%}
  Pattern service row: up to 4 short service notes (postage, collection, delivery…) in columns
  with hairline dividers. Each block: small display heading, 1-3 lines of text, optional link,
  optional 3:2 image above the text. Stacks on mobile with hairlines between items.
{%- endcomment -%}
{{ 'section-pattern-supporting.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="pattern-section pattern-supporting pattern-supporting--{{ section.settings.background }}">
  <div class="pattern-service-row pattern-wrap section-{{ section.id }}-padding{% if section.settings.full_width %} pattern-service-row--full{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="pattern-supporting__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="pattern-service-row__list" role="list" style="--columns: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          <li class="pattern-service-row__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="pattern-service-row__media">
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 960, 1200',
                    sizes: '(min-width: 990px) calc((100vw - 10rem) / 3), (min-width: 750px) calc((100vw - 10rem) / 2), calc(100vw - 3rem)',
                    alt: block.settings.image.alt,
                    class: 'pattern-service-row__image'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="pattern-service-row__title">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="pattern-service-row__text rte">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
              <a href="{{ block.settings.link_url }}" class="pattern-service-row__link">
                {{- block.settings.link_label | escape -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Pattern service row",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave empty to show just the columns."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "transparent", "label": "None" },
        { "value": "sandstone", "label": "Sandstone" },
        { "value": "charcoal", "label": "Charcoal" }
      ],
      "default": "transparent"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Shown above the text, cropped to 3:2."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Postage"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "info": "Keep it to 1-3 lines.",
          "default": "<p>Flat-rate shipping to Portugal and Spain. Order on the website.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Optional. The link shows when both label and link are set."
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pattern service row",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "heading": "Postage",
            "text": "<p>Flat-rate shipping to Portugal and Spain. Order on the website.</p>"
          }
        },
        {
          "type": "service",
          "settings": {
            "heading": "Collect in store",
            "text": "<p>Order online and collect from the shop in Alcântara.</p>"
          }
        },
        {
          "type": "service",
          "settings": {
            "heading": "Lisbon in 24 hours",
            "text": "<p>Flat-fee delivery within Lisbon postcodes.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
