{%- comment -%}
  Pattern feature split ("We buy & exchange"): full-bleed image half and a clay (or ink) text half
  (label, heading with an italic accent word, text, button). Image side is a setting so stacked
  feature splits can alternate. Without an image the half shows the striped placeholder. On
  mobile it stacks with the image first.
{%- endcomment -%}
{%- liquid
  # A url setting can't default to a page, so the button falls back to the sell page when the
  # link is left empty. Clear the button label to hide the button.
  assign button_link = section.settings.button_link | default: '/pages/sell-your-records'

  # Opal is never a large fill: an older saved "accent" panel shows as clay.
  assign tone = section.settings.tone
  if tone != 'ink'
    assign tone = 'clay'
  endif
  # The button is the primary (Opal) button on clay; paper on the ink panel.
  assign button_class = 'pattern-button'
  if tone == 'ink'
    assign button_class = 'pattern-button pattern-button--paper'
  endif
-%}

<section
  class="pattern-section pattern-split pattern-split--image-{{ section.settings.image_position }} pattern-split--{{ tone }}"
  aria-labelledby="PatternSplitHeading-{{ section.id }}"
>
  <div class="pattern-split__media{% if section.settings.image == blank %} pattern-placeholder{% endif %}">
    {%- if section.settings.image != blank -%}
      {%- liquid
        assign focal_point = section.settings.image.presentation.focal_point | default: 'center'
        assign image_style = 'object-position: ' | append: focal_point | append: ';'
      -%}
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          loading: 'lazy',
          widths: '375, 550, 750, 1100, 1500, 1800',
          sizes: '(min-width: 900px) 50vw, 100vw',
          alt: section.settings.image.alt,
          class: 'pattern-split__image',
          style: image_style
      }}
    {%- endif -%}
  </div>

  <div class="pattern-split__text">
    {%- if section.settings.label != blank -%}
      <p class="pattern-label pattern-split__label">{{ section.settings.label | escape }}</p>
    {%- endif -%}
    <h2 class="pattern-display pattern-split__heading" id="PatternSplitHeading-{{ section.id }}">
      {%- render 'pattern-heading-text',
        start: section.settings.heading,
        accent: section.settings.heading_accent,
        end: section.settings.heading_end
      -%}
    </h2>
    {%- if section.settings.text != blank -%}
      <div class="pattern-split__body rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div>
        <a href="{{ button_link }}" class="{{ button_class }}">
          {{- section.settings.button_label | escape -}}
          {% render 'pattern-arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pattern-split {
    display: flex;
    flex-wrap: wrap;
  }

  .pattern-split__media {
    position: relative;
    flex: 1 1 42rem;
    min-width: 0;
    min-height: 64rem;
    overflow: hidden;
  }

  .pattern-split__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pattern-split__text {
    flex: 1 1 42rem;
    min-width: 0;
    box-sizing: border-box;
    min-height: 64rem;
    padding: 7.2rem 5.6rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.8rem;
  }

  /* Tones */
  .pattern-split--ink .pattern-split__text {
    background-color: var(--pattern-ink);
    color: var(--pattern-paper);
  }

  .pattern-split--clay .pattern-split__text {
    background-color: var(--pattern-clay);
    color: var(--pattern-ink);
  }

  .pattern-split__label {
    opacity: 0.9;
  }

  .pattern-split__heading {
    font-size: clamp(4.4rem, 5.4vw, 8rem);
    line-height: 0.95;
    overflow-wrap: break-word;
  }

  .pattern-split__body {
    max-width: 48rem;
    font-size: 1.8rem;
    line-height: 1.55;
    color: inherit;
  }

  .pattern-split__body p {
    margin: 0;
  }

  .pattern-split__body p + p {
    margin-top: 1.2rem;
  }

  .pattern-split__body a {
    color: inherit;
  }

  /* Image on the right: desktop only (image stays first when stacked) */
  @media screen and (min-width: 900px) {
    .pattern-split--image-right .pattern-split__media {
      order: 2;
    }
  }

  @media screen and (max-width: 899px) {
    .pattern-split__media {
      flex-basis: 100%;
      min-height: 0;
      aspect-ratio: 4 / 5;
      max-height: 80vh;
    }

    .pattern-split__text {
      flex-basis: 100%;
      min-height: 0;
      padding: 5.6rem var(--pattern-gutter);
      gap: 2.4rem;
    }

    .pattern-split__body {
      font-size: 1.7rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pattern feature split",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Set a focal point to control the crop. Without an image the half shows a striped placeholder."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image side",
      "info": "Alternate between sections. On mobile the image is always first.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Text panel colour",
      "options": [
        { "value": "clay", "label": "Clay" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "clay"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "We buy & exchange"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading: before the accent word",
      "default": "Bring us your"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading: accent word (italic)",
      "default": "records"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading: after the accent word",
      "default": "."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We buy and exchange records. Bring a crate to the shop or send us a list, and we'll make you an offer or swap them for something new to you.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Clear to hide the button.",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to /pages/sell-your-records."
    }
  ],
  "presets": [
    { "name": "Pattern feature split" }
  ]
}
{% endschema %}
