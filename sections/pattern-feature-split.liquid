{%- comment -%}
  Pattern feature split: image on one side, text on the other (side set in the editor), or text
  over the image with a charcoal overlay. Optional small label, display heading, rich text and a
  square, low-key button. On mobile it always stacks with the image first.
{%- endcomment -%}
{{ 'section-pattern-supporting.css' | asset_url | stylesheet_tag }}

{%- liquid
  # A url setting can't default to a page, so the button falls back to the sell page when the
  # link is left empty. Clear the button label to hide the button.
  assign button_link = section.settings.button_link | default: '/pages/sell-your-records'
  assign is_overlay = false
  if section.settings.layout == 'overlay' and section.settings.image != blank
    assign is_overlay = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="pattern-section pattern-section--{{ section.settings.background }}">
  <div class="section-{{ section.id }}-padding page-width">
    <div
      class="pattern-feature-split pattern-feature-split--image-{{ section.settings.image_position }} pattern-feature-split--ratio-{{ section.settings.image_ratio }}{% if is_overlay %} pattern-feature-split--overlay{% endif %}{% if section.settings.image == blank %} pattern-feature-split--no-image{% endif %}"
      style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
    >
      <div class="pattern-feature-split__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              widths: '375, 550, 750, 1100, 1500, 1800',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: section.settings.image.alt,
              class: 'pattern-feature-split__image'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'pattern-feature-split__placeholder' }}
        {%- endif -%}
      </div>

      <div class="pattern-feature-split__content">
        {%- if section.settings.label != blank -%}
          <p class="pattern-feature-split__label">{{ section.settings.label | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pattern-feature-split__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="pattern-feature-split__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ button_link }}" class="pattern-feature-split__button">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pattern feature split",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image side",
      "info": "On mobile the image is always first.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "3-2", "label": "3:2" },
        { "value": "4-5", "label": "4:5" },
        { "value": "1-1", "label": "1:1" }
      ],
      "default": "4-5"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Text position",
      "options": [
        { "value": "split", "label": "Beside the image" },
        { "value": "overlay", "label": "Over the image" }
      ],
      "default": "split",
      "info": "\"Over the image\" applies on desktop; on mobile the text sits under the image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Charcoal overlay strength",
      "info": "Used when the text is over the image.",
      "default": 45
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "transparent", "label": "None" },
        { "value": "sandstone", "label": "Sandstone" },
        { "value": "charcoal", "label": "Charcoal" }
      ],
      "default": "transparent"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "info": "Optional small line above the heading.",
      "default": "Sell to us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We buy and exchange records"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Clearing shelves or reshaping a collection? Bring your records to the shop in Alcântara and we'll take a look and make you an offer, or swap them for something new to you.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Clear to hide the button.",
      "default": "How selling works"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to /pages/sell-your-records."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Pattern feature split"
    }
  ]
}
{% endschema %}
