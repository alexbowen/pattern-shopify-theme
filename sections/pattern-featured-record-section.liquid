{%- comment -%}
  Pattern featured records: an optional heading and up to 3 Featured record blocks
  (blocks/pattern-featured-record.liquid) side by side, stacking on mobile.
  For Audioly play buttons, add an Apps section directly after this one with Audioly's featured
  collection play buttons block, set to a collection containing the records.
{%- endcomment -%}
{%- assign record_count = section.blocks.size -%}
<section
  class="pattern-section pattern-featured-records pattern-featured-records--count-{{ record_count }} pattern-featured-records--bg-{{ section.settings.background }}{% if section.settings.background == 'dark' %} pattern-stripe-dark{% endif %}"
  {% if section.settings.heading != blank %}
    aria-labelledby="FeaturedRecordsHeading-{{ section.id }}"
  {% else %}
    aria-label="Featured records"
  {% endif %}
>
  <div class="pattern-wrap pattern-featured-records__inner">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="pattern-featured-records__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pattern-label pattern-featured-records__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pattern-display pattern-featured-records__heading" id="FeaturedRecordsHeading-{{ section.id }}">
            {{- section.settings.heading | escape -}}
          </h2>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="pattern-featured-records__grid">
      {%- content_for 'blocks' -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pattern-featured-records {
    --pattern-surface: var(--pattern-paper);
    color: var(--pattern-ink);
  }

  .pattern-featured-records--bg-clay {
    --pattern-surface: var(--pattern-clay);
    background-color: var(--pattern-clay);
  }

  .pattern-featured-records--bg-dark {
    --pattern-surface: var(--pattern-ink);
    background-color: var(--pattern-ink);
    color: var(--pattern-paper);
  }

  .pattern-featured-records__inner {
    display: flex;
    flex-direction: column;
    gap: 3.2rem;
    padding-top: var(--pattern-section-space);
    padding-bottom: var(--pattern-section-space);
  }

  .pattern-featured-records__head {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .pattern-featured-records__eyebrow {
    opacity: 0.85;
  }

  .pattern-featured-records__heading {
    font-size: clamp(3.2rem, 4vw, 5.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .pattern-featured-records__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rem 3.2rem;
  }

  @media screen and (min-width: 990px) {
    .pattern-featured-records--count-2 .pattern-featured-records__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pattern-featured-records--count-3 .pattern-featured-records__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Horizontal cards need room (they stack under ~560px): with any horizontal card the grid gives
     each record at least ~600px, so two sit side by side on a laptop and the rest wrap. */
  @media screen and (min-width: 750px) {
    .pattern-featured-records .pattern-featured-records__grid:has(.pattern-feature--horizontal) {
      grid-template-columns: repeat(auto-fit, minmax(min(60rem, 100%), 1fr));
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .pattern-featured-records--count-2 .pattern-featured-records__grid,
    .pattern-featured-records--count-3 .pattern-featured-records__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pattern featured records",
  "tag": "div",
  "max_blocks": 3,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Optional small mono line above the heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Staff picks"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Section background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "clay", "label": "Clay" },
        { "value": "dark", "label": "Dark stripe" }
      ],
      "default": "none"
    },
    {
      "type": "paragraph",
      "content": "Up to 3 records side by side; they stack on mobile. For Audioly play buttons, add an Apps section directly below with Audioly's featured collection play buttons block."
    }
  ],
  "blocks": [{ "type": "pattern-featured-record" }],
  "presets": [
    {
      "name": "Pattern featured records",
      "blocks": [
        { "type": "pattern-featured-record", "settings": { "layout": "vertical" } },
        { "type": "pattern-featured-record", "settings": { "layout": "vertical" } }
      ]
    }
  ]
}
{% endschema %}
