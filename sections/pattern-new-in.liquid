{%- comment -%}
  Pattern featured collection: one collection as a product grid, for any page or template.
  Optional mono label, display heading, short description, "View all" link; then the shared
  product cards (snippets/card-product.liquid) in Dawn's grid / grid__item list markup, exactly as
  the Latest arrivals section (sections/pattern-new-in-views.liquid), so .card__inner and
  .grid__item match Audioly's selectors.

  - Desktop columns 3–6; two columns on tablet and mobile (or a swipe row on mobile).
  - Products on mobile: cards past that number are hidden with CSS, so they stay in the DOM.
  - Hide sold out: looks through up to 50 products and skips unavailable ones until the grid is
    full.
  - Background Paper / Sand / Clay / Ink / Dark stripe (text, meta, hairlines and links switch to
    paper on the dark two); container Standard or Wide.
  - Empty or no collection: hidden on the live site, a short note in the theme editor.

  Audioly: its "Product card play button" block only works on collection pages. Here, add an Apps
  section directly after this one with Audioly's "Play/pause buttons for featured collection"
  block, set to the same collection (and at least as many products as this grid looks through when
  Hide sold out skips some). It matches cards by product handle; this section's class contains
  "collection" so the block finds it.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign has_products = false
  if featured != blank and featured.products_count > 0
    assign has_products = true
  endif

  assign view_all_url = section.settings.link
  if view_all_url == blank and featured != blank
    assign view_all_url = featured.url
  endif

  assign background = section.settings.background | default: 'paper'
  assign is_dark = false
  if background == 'ink' or background == 'stripes-dark'
    assign is_dark = true
  endif

  assign mobile_hide_from = section.settings.products_on_mobile | plus: 1

  # Hide sold out: look further into the collection (up to 50) so the grid stays full.
  assign scan_limit = products_to_show
  if section.settings.hide_sold_out
    assign scan_limit = 50
  endif

  case section.settings.columns
    when '3'
      assign card_sizes = '(min-width: 990px) 33vw, 50vw'
    when '4'
      assign card_sizes = '(min-width: 990px) 25vw, 50vw'
    when '5'
      assign card_sizes = '(min-width: 990px) 20vw, 50vw'
    else
      assign card_sizes = '(min-width: 990px) 17vw, 50vw'
  endcase
-%}

{%- if has_products or request.design_mode -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .pattern-new-in__grid > .grid__item:nth-child(n + {{ mobile_hide_from }}) {
        display: none;
      }
    }
  {%- endstyle -%}
  <section
    class="pattern-section pattern-new-in pattern-new-in-collection pattern-new-in--{{ background }}{% if background == 'stripes-dark' %} pattern-stripe-dark{% endif %}{% if is_dark %} pattern-new-in--dark{% endif %}"
    aria-labelledby="PatternNewInHeading-{{ section.id }}"
  >
    <div class="pattern-wrap pattern-new-in__inner{% if section.settings.container_width == 'wide' %} pattern-new-in__inner--wide{% endif %}">
      <div class="pattern-new-in__head">
        <div class="pattern-new-in__titles">
          {%- if section.settings.label != blank -%}
            <p class="pattern-label pattern-new-in__label">{{ section.settings.label | escape }}</p>
          {%- endif -%}
          <h2 class="pattern-display pattern-new-in__heading" id="PatternNewInHeading-{{ section.id }}">
            {{- section.settings.heading | escape -}}
            {%- if section.settings.heading_accent != blank %}
              <span class="pattern-accent-word">{{ section.settings.heading_accent | escape }}</span>
            {%- endif -%}
          </h2>
          {%- if section.settings.description != blank -%}
            <p class="pattern-new-in__description">{{ section.settings.description | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.show_link and section.settings.link_label != blank and view_all_url != blank and has_products -%}
          <a href="{{ view_all_url }}" class="pattern-link pattern-new-in__all">
            {{- section.settings.link_label | escape -}}
            {% render 'pattern-arrow' %}
          </a>
        {%- endif -%}
      </div>

      {%- if has_products -%}
        <ul
          class="grid product-grid collection pattern-new-in__grid pattern-new-in__grid--cols-{{ section.settings.columns }}{% if section.settings.mobile_layout == 'swipe' %} pattern-new-in__grid--swipe{% endif %}"
          role="list"
        >
          {%- assign shown = 0 -%}
          {%- for product in featured.products limit: scan_limit -%}
            {%- if section.settings.hide_sold_out and product.available == false -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign shown = shown | plus: 1
              assign skip_card_styles = true
              if shown == 1
                assign skip_card_styles = false
              endif
            -%}
            <li class="grid__item">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: 'default',
                show_secondary_image: false,
                show_vendor: false,
                show_rating: false,
                lazy_load: true,
                skip_styles: skip_card_styles,
                quick_add: 'none',
                section_id: section.id
              %}
            </li>
            {%- if shown >= products_to_show -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="pattern-new-in__empty">
          Pick a collection with products. Until then this section is hidden on the live site; this note only shows in the theme editor.
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .pattern-new-in {
    color: var(--pattern-ink);
    background-color: var(--pattern-paper);
  }

  .pattern-new-in--sand { background-color: var(--pattern-sand); }
  .pattern-new-in--clay { background-color: var(--pattern-clay); }
  .pattern-new-in--ink { background-color: var(--pattern-ink); }
  .pattern-new-in--stripes-dark { background-color: var(--pattern-stripe-dark-a); }

  .pattern-new-in__inner {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-top: var(--pattern-section-space);
    padding-bottom: var(--pattern-section-space);
  }

  .pattern-new-in__inner--wide {
    max-width: 168rem;
  }

  .pattern-new-in__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.2rem 3.2rem;
  }

  .pattern-new-in__titles {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    min-width: 0;
    max-width: 72rem;
  }

  .pattern-new-in__label,
  .pattern-new-in__description {
    margin: 0;
    color: var(--pattern-muted);
  }

  .pattern-new-in__heading {
    font-size: clamp(4rem, 5vw, 7.2rem);
    line-height: 1;
    letter-spacing: -0.04em;
    overflow-wrap: break-word;
  }

  .pattern-new-in__description {
    font-size: 1.6rem;
    line-height: 1.5;
  }

  /* View all: underline on hover in the text colour, accent arrow (as elsewhere) */
  .pattern-new-in__all {
    flex: 0 0 auto;
    text-decoration-thickness: 0.1rem;
    text-underline-offset: 0.4rem;
  }

  .pattern-new-in__all:hover {
    text-decoration-line: underline;
    text-decoration-color: currentColor;
  }

  .pattern-new-in__all:focus-visible {
    outline: 0.2rem solid currentColor;
    outline-offset: 0.3rem;
  }

  /* Grid: Dawn's .grid is a flex row with fixed widths; here a CSS grid. Desktop 3–6, else 2. */
  .pattern-new-in .pattern-new-in__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pattern-new-in .pattern-new-in__grid > .grid__item {
    width: auto;
    max-width: none;
    padding: 0;
  }

  @media screen and (min-width: 990px) {
    .pattern-new-in .pattern-new-in__grid--cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .pattern-new-in .pattern-new-in__grid--cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .pattern-new-in .pattern-new-in__grid--cols-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .pattern-new-in .pattern-new-in__grid--cols-6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 749px) {
    .pattern-new-in .pattern-new-in__grid {
      gap: 3.2rem 1.2rem;
    }

    .pattern-new-in .pattern-new-in__grid--swipe {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 44%;
      gap: 1.2rem;
      margin-left: calc(var(--pattern-gutter) * -1);
      margin-right: calc(var(--pattern-gutter) * -1);
      padding: 0 var(--pattern-gutter) 0.8rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-left: var(--pattern-gutter);
      scrollbar-width: none;
    }

    .pattern-new-in .pattern-new-in__grid--swipe::-webkit-scrollbar {
      display: none;
    }

    .pattern-new-in .pattern-new-in__grid--swipe > .grid__item {
      scroll-snap-align: start;
    }
  }

  .pattern-new-in__empty {
    margin: 0;
    padding: 2.4rem;
    border: 0.1rem dashed var(--pattern-hairline);
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--pattern-muted);
  }

  /* ===== Ink / Dark stripe: paper heading, card text, meta, hairlines and links ===== */
  .pattern-new-in--dark {
    color: var(--pattern-paper);
  }

  .pattern-new-in--dark .pattern-new-in__label,
  .pattern-new-in--dark .pattern-new-in__description,
  .pattern-new-in--dark .pattern-new-in__empty {
    color: var(--pattern-paper-dim);
  }

  .pattern-new-in--dark .pattern-new-in__empty {
    border-color: var(--pattern-hairline-on-dark);
  }

  .pattern-new-in--dark .card-wrapper {
    --card-text: var(--pattern-paper);
    --card-muted: var(--pattern-paper-dim);
    --color-card-title: var(--pattern-paper-dim);
    color: var(--pattern-paper);
  }

  .pattern-new-in--dark .card-wrapper :is(.card__heading, .card__heading a, .card-pattern__link, .price, .price-item) {
    color: var(--pattern-paper);
  }

  .pattern-new-in--dark .card-wrapper .card__media::after {
    box-shadow: inset 0 0 0 0.1rem var(--pattern-hairline-on-dark);
  }

  .pattern-new-in--dark .card-pattern__price-row {
    border-top-color: var(--pattern-hairline-on-dark);
  }

  .pattern-new-in--dark .pattern-tag {
    border-color: var(--pattern-paper);
    color: var(--pattern-paper);
  }

  .pattern-new-in--dark .card-wrapper:has(a:focus-visible) {
    outline-color: var(--pattern-paper);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pattern collection grid",
  "tag": "div",
  "class": "pattern-new-in-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Audioly play buttons: add an Apps section directly below with Audioly's \"Play/pause buttons for featured collection\" block, set to the same collection. Set its number of products at least as high as this grid's, and higher if Hide sold out skips some."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label above the heading",
      "info": "Small mono text. Optional."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word (italic)",
      "info": "Optional. Added after the heading."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "A short line under the heading. Optional."
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "View all link",
      "info": "Leave empty to link to the collection."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "label": "Number of products",
      "default": 6
    },
    {
      "type": "range",
      "id": "products_on_mobile",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products on mobile",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold out",
      "info": "Skips sold-out records and fills the grid with the next ones.",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "6",
      "info": "Two on tablet and mobile."
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "swipe", "label": "Swipe row" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "sand", "label": "Sand" },
        { "value": "clay", "label": "Clay" },
        { "value": "ink", "label": "Ink" },
        { "value": "stripes-dark", "label": "Stripes, dark" }
      ],
      "default": "paper"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "info": "Wide runs up to ~1680px, as on the collection page's Wide setting.",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "wide", "label": "Wide" }
      ],
      "default": "standard"
    }
  ],
  "presets": [
    { "name": "Pattern collection grid" }
  ]
}
{% endschema %}
