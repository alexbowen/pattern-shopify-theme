{%- comment -%}
  The record just added, for the cart notification (cart-notification.js copies the inner HTML of
  #cart-notification-product-{key}). A slim cart row (cover, artist / title, label, format · genre,
  unit price + condition tag, and the line total) and the cart subtotal, inside that element so they come across together.
{%- endcomment -%}
{%- if cart != empty -%}
  {%- for item in cart.items -%}
    <div id="cart-notification-product-{{ item.key }}" class="cart-item">
      <div class="pattern-cart-mini">
        <div class="pattern-cart-mini__media">
          {%- if item.image -%}
            {{
              item.image
              | image_url: width: 160
              | image_tag: loading: 'lazy', widths: '72, 144', sizes: '72px', alt: '', class: 'pattern-cart-mini__image'
            }}
          {%- endif -%}
        </div>
        <div class="pattern-cart-mini__details">
          {%- liquid
            assign unit_price = item.final_price | money
            assign unit_compare = ''
            if item.original_price != item.final_price
              assign unit_compare = item.original_price | money
            endif
          -%}
          {% render 'pattern-cart-record', product: item.product, url: item.url, price: unit_price, compare_price: unit_compare %}
          {%- unless item.product.has_only_default_variant -%}
            <dl class="pattern-cart-item__options">
              {%- for option in item.options_with_values -%}
                <div class="product-option">
                  <dt>{{ option.name }}:</dt>
                  <dd>{{ option.value }}</dd>
                </div>
              {%- endfor -%}
            </dl>
          {%- endunless -%}
        </div>
        <p class="pattern-cart-mini__price">{{ item.final_line_price | money }}</p>
      </div>
      <div class="pattern-cart-mini__subtotal">
        <span>{{ 'sections.cart.pattern_subtotal' | t }} · {{ 'sections.cart.pattern_item_count' | t: count: cart.item_count }}</span>
        <span class="pattern-cart-mini__subtotal-value">{{ cart.total_price | money_with_currency }}</span>
      </div>
    </div>
  {%- endfor -%}
{%- endif -%}
