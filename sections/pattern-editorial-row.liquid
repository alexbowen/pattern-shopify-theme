{%- comment -%}
  Pattern editorial row ("From the shop"): heading with an italic accent word, an "all stories"
  link, and up to 4 story blocks (image, tag, title, blurb, link). Images fall back to the striped
  placeholder. The title is the story's link; the image repeats it for pointer users only.
{%- endcomment -%}
<section class="pattern-section pattern-editorial" aria-labelledby="PatternEditorialHeading-{{ section.id }}">
  <div class="pattern-wrap pattern-editorial__inner">
    <div class="pattern-editorial__head">
      <h2 class="pattern-display pattern-editorial__heading" id="PatternEditorialHeading-{{ section.id }}">
        {%- render 'pattern-heading-text',
          start: section.settings.heading,
          accent: section.settings.heading_accent,
          end: section.settings.heading_end
        -%}
      </h2>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="pattern-link">
          {{- section.settings.link_label | escape -}}
          {% render 'pattern-arrow' %}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="pattern-editorial__grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign story_link = block.settings.link -%}
          <li class="pattern-editorial__story" {{ block.shopify_attributes }}>
            {%- capture story_media -%}
              <div class="pattern-editorial__media{% if block.settings.image == blank %} pattern-placeholder{% endif %}">
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign focal_point = block.settings.image.presentation.focal_point | default: 'center'
                    assign image_style = 'object-position: ' | append: focal_point | append: ';'
                  -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '375, 550, 750, 900, 1200',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      alt: block.settings.image.alt,
                      class: 'pattern-editorial__image',
                      style: image_style
                  }}
                {%- endif -%}
              </div>
            {%- endcapture -%}

            {%- if story_link != blank -%}
              <a href="{{ story_link }}" class="pattern-editorial__media-link" tabindex="-1" aria-hidden="true">
                {{- story_media -}}
              </a>
            {%- else -%}
              {{- story_media -}}
            {%- endif -%}

            {%- if block.settings.tag != blank -%}
              <p class="pattern-label pattern-editorial__tag">{{ block.settings.tag | escape }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="pattern-editorial__title">
                {%- if story_link != blank -%}
                  <a href="{{ story_link }}" class="pattern-editorial__title-link">{{ block.settings.title | escape }}</a>
                {%- else -%}
                  {{- block.settings.title | escape -}}
                {%- endif -%}
              </h3>
            {%- endif -%}
            {%- if block.settings.blurb != blank -%}
              <p class="pattern-editorial__blurb">{{ block.settings.blurb | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pattern-editorial__inner {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-top: var(--pattern-section-space);
    padding-bottom: var(--pattern-section-space);
  }

  .pattern-editorial__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.2rem;
  }

  .pattern-editorial__heading {
    font-size: clamp(4rem, 5vw, 7.2rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .pattern-editorial__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(30rem, 100%), 1fr));
    gap: 4rem 2.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pattern-editorial__story {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    min-width: 0;
  }

  .pattern-editorial__media-link {
    display: block;
  }

  .pattern-editorial__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .pattern-editorial__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .pattern-editorial__story:hover .pattern-editorial__image {
    transform: scale(1.03);
  }

  /* Tag: charcoal text with a small accent square (accent text on paper would be too faint) */
  .pattern-editorial__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--pattern-ink);
  }

  .pattern-editorial__tag::before {
    content: '';
    flex: 0 0 auto;
    width: 0.8rem;
    height: 0.8rem;
    background-color: var(--pattern-accent);
  }

  .pattern-editorial__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: inherit;
  }

  .pattern-editorial__title-link {
    color: inherit;
    text-decoration: none;
  }

  .pattern-editorial__story:hover .pattern-editorial__title-link,
  .pattern-editorial__title-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  .pattern-editorial__blurb {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.5;
    color: var(--pattern-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .pattern-editorial__image {
      transition: none;
    }

    .pattern-editorial__story:hover .pattern-editorial__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pattern editorial row",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading: before the accent word",
      "default": "From the shop"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading: accent word (italic)",
      "info": "Optional."
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading: after the accent word"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All news"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "e.g. your blog. The link hides until this is set."
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown at 4:3. Without an image the card shows a striped placeholder."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Staff pick"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Story title"
        },
        {
          "type": "textarea",
          "id": "blurb",
          "label": "Blurb",
          "default": "One line on why it's worth your time."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "A blog post, product, collection or page."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pattern editorial row",
      "blocks": [
        { "type": "story", "settings": { "tag": "Mix" } },
        { "type": "story", "settings": { "tag": "Label spotlight" } },
        { "type": "story", "settings": { "tag": "Staff pick" } }
      ]
    }
  ]
}
{% endschema %}
