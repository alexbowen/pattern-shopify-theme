{%- comment -%}
  Pattern hero: ink text panel (eyebrow, headline with an italic accent word, body, two calls to
  action) beside an image panel. Featured records live in sections/pattern-this-week.liquid. The image uses its focal point; without one
  the panel shows the striped placeholder. Image side and an optional charcoal overlay are
  settings. Stacks on mobile with the text first.
{%- endcomment -%}
{%- liquid
  # Empty: jump to the genre tiles further down the homepage (sections/pattern-genre-tiles.liquid).
  assign secondary_link = section.settings.secondary_link | default: '#browse-by-genre'
-%}

<section
  class="pattern-section pattern-hero pattern-hero--image-{{ section.settings.image_position }}"
  aria-labelledby="PatternHeroHeading-{{ section.id }}"
>
  <div class="pattern-hero__text{% if section.settings.background_texture == 'stripes' %} pattern-stripe-dark{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pattern-label pattern-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <div class="pattern-hero__main">
      <h1 class="pattern-display pattern-hero__headline" id="PatternHeroHeading-{{ section.id }}">
        {{- section.settings.headline_start | escape -}}
        {%- if section.settings.headline_accent != blank %}
          <span class="pattern-accent-word">{{ section.settings.headline_accent | escape }}</span>
        {%- endif -%}
        {%- if section.settings.headline_end != blank %}
          {{ section.settings.headline_end | escape }}
        {%- endif -%}
      </h1>

      {%- if section.settings.body != blank -%}
        <p class="pattern-hero__body">{{ section.settings.body | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
        <div class="pattern-hero__ctas">
          {%- if section.settings.primary_label != blank -%}
            <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="pattern-button">
              {{- section.settings.primary_label | escape -}}
              {% render 'pattern-arrow' %}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a href="{{ secondary_link }}" class="pattern-link pattern-hero__secondary">
              {{- section.settings.secondary_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>

  <div class="pattern-hero__media{% if section.settings.image == blank %} pattern-placeholder{% endif %}">
    {%- if section.settings.image != blank -%}
      {%- liquid
        assign hero_focal_point = section.settings.image.presentation.focal_point | default: 'center'
        assign hero_image_style = 'object-position: ' | append: hero_focal_point | append: ';'
      -%}
      {%- comment -%} Above the fold: load eagerly with high priority. {%- endcomment -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '375, 550, 750, 1100, 1500, 1800, 2400',
          sizes: '(min-width: 990px) 45vw, 100vw',
          alt: section.settings.image.alt,
          class: 'pattern-hero__image',
          style: hero_image_style
      }}
    {%- endif -%}
  </div>
</section>

{%- style -%}
  #shopify-section-{{ section.id }} .pattern-hero__media::after {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

{% stylesheet %}
  .pattern-hero {
    display: flex;
    flex-wrap: wrap;
    background-color: var(--pattern-ink);
    color: var(--pattern-paper);
  }

  .pattern-hero__text {
    flex: 1 1 56rem;
    box-sizing: border-box;
    min-width: 0;
    min-height: 68rem;
    padding: 5.6rem var(--pattern-gutter) 4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4.8rem;
  }

  .pattern-hero__eyebrow {
    color: var(--pattern-paper-dim);
  }

  .pattern-hero__main {
    display: flex;
    flex-direction: column;
    gap: 3.2rem;
  }

  .pattern-hero__headline {
    font-size: clamp(5.6rem, 8.4vw, 12.8rem);
    line-height: 0.9;
    color: inherit;
    overflow-wrap: break-word;
  }

  .pattern-hero__body {
    margin: 0;
    max-width: 47rem;
    font-size: 1.8rem;
    line-height: 1.5;
    color: var(--pattern-paper-soft);
  }

  .pattern-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 2.8rem;
  }

  .pattern-hero__secondary {
    font-size: 1.6rem;
    color: var(--pattern-paper);
  }

  .pattern-hero__media {
    position: relative;
    flex: 1 1 38rem;
    min-width: 0;
    min-height: 56rem;
    overflow: hidden;
  }

  .pattern-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pattern-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--pattern-ink);
    opacity: 0;
    pointer-events: none;
  }

  /* Image on the left: desktop only (text stays first on mobile) */
  @media screen and (min-width: 990px) {
    .pattern-hero--image-left .pattern-hero__media {
      order: -1;
    }
  }

  @media screen and (max-width: 749px) {
    .pattern-hero__text {
      min-height: 0;
      padding-top: 4rem;
      padding-bottom: 3.2rem;
      gap: 4rem;
    }

    .pattern-hero__body {
      font-size: 1.7rem;
    }

    .pattern-hero__media {
      flex-basis: 100%;
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pattern hero",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Record shop & cultural space — Alcântara, Lisboa"
    },
    {
      "type": "text",
      "id": "headline_start",
      "label": "Headline: before the accent word",
      "default": "New cuts"
    },
    {
      "type": "text",
      "id": "headline_accent",
      "label": "Headline: accent word (italic)",
      "default": "for"
    },
    {
      "type": "text",
      "id": "headline_end",
      "label": "Headline: after the accent word",
      "default": "curious listeners"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Fresh arrivals from the crates — house, jazz, disco, dub and everything in between. New and used vinyl, in Lisbon and online."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link label",
      "default": "Browse by genre"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link",
      "info": "Leave empty to jump to the genre tiles on the homepage."
    },
    {
      "type": "select",
      "id": "background_texture",
      "label": "Background texture",
      "info": "Behind the text panel.",
      "options": [
        { "value": "stripes", "label": "Stripes" },
        { "value": "flat", "label": "Flat" }
      ],
      "default": "stripes"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Set a focal point on the image to control the crop. Without an image the panel shows a striped placeholder."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image side",
      "info": "Desktop only. On mobile the image sits below the text.",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Charcoal overlay strength",
      "default": 0
    }
  ],
  "presets": [
    { "name": "Pattern hero" }
  ]
}
{% endschema %}
