      "default": "#new-arrivals"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary link label",
      "info": "Leave empty to hide the link.",
      "default": "Browse by genre"
    },
    {
      "type": "text",
      "id": "secondary_link",
      "label": "Secondary link",
      "info": "A page address, or \"#\" and a section's Anchor ID. Leave empty to jump to the genre tiles on the homepage."
    },
    {
      "type": "text",
      "id": "tertiary_label",
      "label": "Third link label",
      "info": "Leave empty to hide the link.",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "tertiary_link",
      "label": "Third link",
      "info": "A page address, or \"#\" and a section's Anchor ID. Leave empty to jump to #coming-soon. A link to a section that isn't on the page is hidden.",
      "default": "#coming-soon"
    },
    {
      "type": "select",
      "id": "background_texture",
      "label": "Background texture",
      "info": "Split layout: behind the text panel.",
      "options": [
        { "value": "stripes", "label": "Stripes" },
        { "value": "flat", "label": "Flat" }
      ],
      "default": "stripes"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Set a focal point to control the crop. Full image: without an image the hero shows the dark stripe texture. Split: a striped placeholder."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description (alt text)",
      "info": "Full image layout. Leave empty if the photo is decorative."
    },
    {
      "type": "header",
      "content": "Full image layout"
    },
    {
