    {
      "type": "range",
      "id": "full_height_mobile",
      "min": 320,
      "max": 640,
      "step": 20,
      "unit": "px",
      "label": "Height on mobile",
      "info": "Used when \"Fill the first screen\" is off. Minimum height on phones; the hero grows if the text needs more room.",
      "default": 460
