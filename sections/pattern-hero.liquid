{%- comment -%}
  Pattern hero, two layouts (Layout setting):
  - Full image (default): the photo fills the hero behind a dark gradient, with the text over it on
    the page container's left edge. Optional mobile image. A bottom fade blends the photo into the
    dark stripe texture of the section below ("This week"). No image: the stripe texture.
  - Split: ink text panel beside an image panel (image side and a charcoal overlay are settings);
    stacks on mobile with the text first.
  The eyebrow, headline (with an italic accent word), body and two calls to action are shared.
  Featured records live in sections/pattern-this-week.liquid.
{%- endcomment -%}
{%- liquid
  # Empty: jump to the genre tiles further down the homepage (sections/pattern-genre-tiles.liquid).
  assign secondary_link = section.settings.secondary_link | default: '#browse-by-genre'
  assign layout = section.settings.layout | default: 'full'
-%}

{%- capture hero_eyebrow -%}
  {%- if section.settings.eyebrow != blank -%}
    <p class="pattern-label pattern-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
  {%- endif -%}
{%- endcapture -%}

{%- capture hero_main -%}
  <div class="pattern-hero__main">
    <h1 class="pattern-display pattern-hero__headline" id="PatternHeroHeading-{{ section.id }}">
      {{- section.settings.headline_start | escape -}}
      {%- if section.settings.headline_accent != blank %}
        <span class="pattern-accent-word">{{ section.settings.headline_accent | escape }}</span>
      {%- endif -%}
      {%- if section.settings.headline_end != blank %}
        {{ section.settings.headline_end | escape }}
      {%- endif -%}
    </h1>

    {%- if section.settings.body != blank -%}
      <p class="pattern-hero__body">{{ section.settings.body | escape | newline_to_br }}</p>
    {%- endif -%}

    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank or section.settings.tertiary_label != blank -%}
      {%- liquid
        assign primary_link = section.settings.primary_link | default: routes.all_products_collection_url | strip
        assign primary_first = primary_link | slice: 0
        assign tertiary_link = section.settings.tertiary_link | default: '#coming-soon' | strip
      -%}
      <div class="pattern-hero__ctas" data-pattern-hero-ctas>
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ primary_link }}" class="pattern-button">
            {{- section.settings.primary_label | escape -}}
            {%- if primary_first == '#' -%}
              {%- comment -%} On-page anchor: a down arrow instead of the right arrow {%- endcomment -%}
              <svg class="pattern-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M8 2v11M4 9l4 4 4-4"/></svg>
            {%- else -%}
              {% render 'pattern-arrow' %}
            {%- endif -%}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ secondary_link }}" class="pattern-link pattern-hero__secondary">
            {{- section.settings.secondary_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.tertiary_label != blank -%}
          <a href="{{ tertiary_link }}" class="pattern-link pattern-hero__secondary">
            {{- section.settings.tertiary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- if layout == 'full' -%}
  {%- liquid
    assign hero_image = section.settings.image
    assign mobile_image = section.settings.mobile_image | default: hero_image
    assign focal = hero_image.presentation.focal_point | default: 'center'
    assign focal_mobile = mobile_image.presentation.focal_point | default: focal

    # Overlay alphas (ink #141413). The text side is darker than the setting so light text stays
    # readable even over a bright photo; phones get a stronger, bottom-up gradient.
    assign strength = section.settings.full_overlay | divided_by: 100.0
    assign text_alpha = strength | times: 1.35
    if text_alpha > 0.92
      assign text_alpha = 0.92
    endif
    assign far_alpha = strength | times: 0.3
    assign mobile_alpha = strength | plus: 0.3
    if mobile_alpha > 0.92
      assign mobile_alpha = 0.92
    endif

    assign hero_fill = section.settings.fill_screen
    assign hero_parallax = false
    if section.settings.parallax == 'subtle' and hero_image != blank
      assign hero_parallax = true
    endif
    # The parallax layer is scaled 1.2x on tablets and desktops, so ask for a 20% wider image there
    assign hero_sizes = '100vw'
    if hero_parallax
      assign hero_sizes = '(min-width: 750px) 120vw, 100vw'
    endif
  -%}
  <section
    id="PatternHero-{{ section.id }}"
    class="pattern-section pattern-hero pattern-hero--full pattern-hero--overlay-{{ section.settings.overlay_direction }}{% if hero_image == blank %} pattern-hero--no-image{% endif %}{% if hero_fill %} pattern-hero--fill{% endif %}{% if hero_parallax %} pattern-hero--parallax{% endif %}"
    aria-labelledby="PatternHeroHeading-{{ section.id }}"
    style="--hero-h: {{ section.settings.full_height }}px; --hero-h-mobile: {{ section.settings.full_height_mobile | default: 460 }}px; --hero-pad-top: {{ section.settings.full_padding_top | default: 48 }}px; --hero-pad-bottom: {{ section.settings.full_padding_bottom | default: 48 }}px; --hero-focal: {{ focal }}; --hero-focal-mobile: {{ focal_mobile }}; --hero-a-text: {{ text_alpha }}; --hero-a-mid: {{ strength }}; --hero-a-far: {{ far_alpha }}; --hero-a-mobile: {{ mobile_alpha }};"
  >
    <div class="pattern-hero__bg{% if hero_image == blank %} pattern-stripe-dark{% endif %}" aria-hidden="{% if section.settings.image_alt == blank %}true{% else %}false{% endif %}">
      {%- if hero_image != blank -%}
        <picture>
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{- mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 1100 }} 1100w,
                {{ mobile_image | image_url: width: 1500 }} 1500w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {%- comment -%} Above the fold: eager, high priority, no lazy loading. {%- endcomment -%}
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '375, 550, 750, 1100, 1500, 1800, 2400',
              sizes: hero_sizes,
              alt: section.settings.image_alt,
              class: 'pattern-hero__bg-image'
          }}
        </picture>
        <div class="pattern-hero__overlay"></div>
      {%- endif -%}
      {%- if section.settings.bottom_fade -%}
        <div class="pattern-hero__fade pattern-stripe-dark"></div>
      {%- endif -%}
    </div>

    <div class="pattern-wrap pattern-hero__content-wrap">
      <div class="pattern-hero__content">
        {{ hero_eyebrow }}
        {{ hero_main }}
      </div>
    </div>
  </section>

  {%- if hero_fill or hero_parallax -%}
    <script>
      /* Pattern hero: "Fill the first screen" and "Parallax" (sections/pattern-hero.liquid).
         Fill: --hero-above = everything above the hero (announcement bar, header) and --hero-below =
         the height of the "This week" section right after it, so header + hero + This week = the
         screen height.
         The CSS clamps the hero to 360-880px and has a fallback offset for before this runs.
         Parallax: the image layer (not the text, overlay or fade) moves down at 20% of the scroll
         speed while the hero is on screen; transform only, rAF-throttled, tablets and up, off with
         reduced motion. */
      (() => {
        const hero = document.getElementById('PatternHero-{{ section.id }}');
        if (!hero) return;

        if (hero.classList.contains('pattern-hero--fill')) {
          const heroSection = hero.closest('.shopify-section') || hero;
          // The This week section directly after the hero (empty sections, e.g. Apps, are skipped).
          const findThisWeek = () => {
            let el = heroSection.nextElementSibling;
            while (el) {
              if (el.querySelector('.pattern-this-week')) return el;
              if (el.getBoundingClientRect().height > 0) return null;
              el = el.nextElementSibling;
            }
            return null;
          };
          let thisWeek = null;
          let observer = null;
          // --hero-above: announcement bar + header (known as soon as this runs).
          // --hero-below: the This week section; while the page is still loading and it isn't
          // parsed yet, the CSS estimate stays in place.
          const measure = () => {
            const above = hero.getBoundingClientRect().top + window.scrollY;
            hero.style.setProperty('--hero-above', `${Math.max(0, Math.round(above))}px`);
            const found = findThisWeek();
            if (found !== thisWeek) {
              thisWeek = found;
              if (observer && thisWeek) observer.observe(thisWeek);
            }
            if (thisWeek) {
              hero.style.setProperty('--hero-below', `${Math.round(thisWeek.getBoundingClientRect().height)}px`);
            } else if (document.readyState !== 'loading' || heroSection.nextElementSibling) {
              hero.style.setProperty('--hero-below', '0px');
            }
          };
          measure();
          if ('ResizeObserver' in window) {
            observer = new ResizeObserver(measure);
            const header = document.querySelector('.shopify-section-group-header-group') || document.querySelector('header');
            if (header) observer.observe(header);
            if (thisWeek) observer.observe(thisWeek);
          }
          document.addEventListener('DOMContentLoaded', measure);
          window.addEventListener('load', measure);
          window.addEventListener('resize', measure, { passive: true });
          window.addEventListener('orientationchange', measure);
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
        }

        if (hero.classList.contains('pattern-hero--parallax')) {
          const layer = hero.querySelector('.pattern-hero__bg picture');
          if (!layer) return;
          const SPEED = 0.2;
          const SCALE = 1.2; // must match the CSS
          const motion = window.matchMedia('(min-width: 750px) and (prefers-reduced-motion: no-preference)');
          let inView = true;
          let ticking = false;
          const update = () => {
            ticking = false;
            if (!motion.matches) {
              layer.style.transform = '';
              return;
            }
            // Never move further than the extra height the scale gives above the hero
            const max = hero.offsetHeight * (SCALE - 1);
            const shift = Math.min(Math.max(window.scrollY, 0) * SPEED, max);
            layer.style.transform = `translate3d(0, ${shift.toFixed(1)}px, 0) scale(${SCALE})`;
          };
          const request = () => {
            if (!inView || ticking) return;
            ticking = true;
            requestAnimationFrame(update);
          };
          if ('IntersectionObserver' in window) {
            new IntersectionObserver((entries) => {
              inView = entries[0].isIntersecting;
              if (inView) request();
            }).observe(hero);
          }
          window.addEventListener('scroll', request, { passive: true });
          window.addEventListener('resize', request, { passive: true });
          motion.addEventListener('change', () => {
            ticking = false;
            update();
          });
          update();
        }
      })();
    </script>
  {%- endif -%}
{%- else -%}

<section
  class="pattern-section pattern-hero pattern-hero--split pattern-hero--image-{{ section.settings.image_position }}"
  aria-labelledby="PatternHeroHeading-{{ section.id }}"
>
  <div class="pattern-hero__text{% if section.settings.background_texture == 'stripes' %} pattern-stripe-dark{% endif %}">
    {{ hero_eyebrow }}
    {{ hero_main }}
  </div>

  <div class="pattern-hero__media{% if section.settings.image == blank %} pattern-placeholder{% endif %}">
    {%- if section.settings.image != blank -%}
      {%- liquid
        assign hero_focal_point = section.settings.image.presentation.focal_point | default: 'center'
        assign hero_image_style = 'object-position: ' | append: hero_focal_point | append: ';'
      -%}
      {%- comment -%} Above the fold: load eagerly with high priority. {%- endcomment -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '375, 550, 750, 1100, 1500, 1800, 2400',
          sizes: '(min-width: 990px) 45vw, 100vw',
          alt: section.settings.image.alt,
          class: 'pattern-hero__image',
          style: hero_image_style
      }}
    {%- endif -%}
  </div>
</section>

{%- style -%}
  #shopify-section-{{ section.id }} .pattern-hero__media::after {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}
{%- endif -%}

<script>
  /* Hero links to sections on this page (href "#..."): hide a link whose target isn't on the page
     (or isn't shown, e.g. an empty Coming soon), and scroll smoothly to the others (instantly with
     reduced motion). Targets land below the sticky header with 16px to spare: scroll-margin-top
     uses --pattern-anchor-offset (assets/pattern-base.css), set here. Without JavaScript the links
     stay visible and jump normally. */
  (() => {
    const setup = () => {
      const header = document.querySelector('.shopify-section-group-header-group, .section-header, sticky-header');
      const setOffset = () => {
        let height = 0;
        if (header) {
          const position = getComputedStyle(header).position;
          if (position === 'sticky' || position === 'fixed') height = header.getBoundingClientRect().height;
        }
        document.documentElement.style.setProperty('--pattern-anchor-offset', `${Math.round(height + 16)}px`);
      };
      setOffset();
      window.addEventListener('resize', setOffset, { passive: true });

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      document.querySelectorAll('[data-pattern-hero-ctas] a[href^="#"]').forEach((link) => {
        const id = decodeURIComponent(link.getAttribute('href').slice(1));
        const target = id ? document.getElementById(id) : null;
        if (!target || target.getClientRects().length === 0) {
          link.hidden = true;
          return;
        }
        link.addEventListener('click', (event) => {
          event.preventDefault();
          target.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
          if (history.pushState) history.pushState(null, '', `#${id}`);
          if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
          target.focus({ preventScroll: true });
        });
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup);
    else setup();
  })();
</script>

{% stylesheet %}
  .pattern-hero {
    background-color: var(--pattern-ink);
    color: var(--pattern-paper);
    container-type: inline-size;
  }

  /* ===== Full image layout ===== */
  .pattern-hero--full {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* Height on desktop (a minimum: longer text makes it taller), never above 80% of the screen */
    min-height: min(var(--hero-h, 440px), 80vh);
    overflow: hidden;
  }

  .pattern-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .pattern-hero__bg picture,
  .pattern-hero__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pattern-hero__bg-image {
    object-fit: cover;
    object-position: var(--hero-focal, center);
  }

  /* Dawn hides empty divs (base.css div:empty); the overlay and fade are empty on purpose */
  .pattern-hero .pattern-hero__overlay,
  .pattern-hero .pattern-hero__fade {
    display: block;
  }

  /* Dark gradient (ink). Default: left to right, darkest behind the text. */
  .pattern-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(20, 20, 19, var(--hero-a-text)) 0%,
      rgba(20, 20, 19, var(--hero-a-text)) 42%,
      rgba(20, 20, 19, var(--hero-a-far)) 100%
    );
  }

  .pattern-hero--overlay-bottom .pattern-hero__overlay {
    background: linear-gradient(
      0deg,
      rgba(20, 20, 19, var(--hero-a-text)) 0%,
      rgba(20, 20, 19, var(--hero-a-mid)) 55%,
      rgba(20, 20, 19, var(--hero-a-far)) 100%
    );
  }

  .pattern-hero--overlay-even .pattern-hero__overlay {
    background: rgba(20, 20, 19, var(--hero-a-mid));
  }

  /* Bottom fade: the stripe texture of the section below, faded in over the last ~28% */
  .pattern-hero__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 28%;
    background-color: var(--pattern-ink);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000);
    mask-image: linear-gradient(to bottom, transparent, #000);
    pointer-events: none;
  }

  /* ===== Fill the first screen =====
     Header + hero + the This week section after it = the screen height (100svh, so phone toolbars
     don't make it jump; 100vh where svh isn't supported). The script in this section measures
     --hero-above and --hero-below; until it runs, the fallbacks are the usual header height and
     the usual This week height (--hero-below-guess), which drops to 0 as soon as the section after
     the hero turns out not to be This week (its wrapper gets .pattern-this-week-section from that
     section's schema). The page can be laid out before the next section has arrived, so "This
     week follows" is the starting assumption.
     Never under 360px (taller windows get the page below the fold) or over 880px. */
  .pattern-hero--full.pattern-hero--fill {
    min-height: clamp(36rem, calc(100vh - var(--hero-above, 9.3rem) - var(--hero-below, var(--hero-below-guess, 0px))), 88rem);
    justify-content: center;
  }

  @supports (height: 100svh) {
    .pattern-hero--full.pattern-hero--fill {
      min-height: clamp(36rem, calc(100svh - var(--hero-above, 9.3rem) - var(--hero-below, var(--hero-below-guess, 0px))), 88rem);
    }
  }

  .pattern-hero--fill {
    --hero-below-guess: 14.1rem;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .pattern-hero--fill {
      --hero-below-guess: 15.9rem;
    }
  }

  @media screen and (max-width: 749px) {
    .pattern-hero--full.pattern-hero--fill {
      min-height: clamp(36rem, calc(100vh - var(--hero-above, 11.8rem) - var(--hero-below, var(--hero-below-guess, 0px))), 88rem);
    }

    @supports (height: 100svh) {
      .pattern-hero--full.pattern-hero--fill {
        min-height: clamp(36rem, calc(100svh - var(--hero-above, 11.8rem) - var(--hero-below, var(--hero-below-guess, 0px))), 88rem);
      }
    }

    .pattern-hero--fill {
      --hero-below-guess: 15.1rem;
    }
  }

  .shopify-section:has(+ .shopify-section:not(.pattern-this-week-section)) .pattern-hero--fill {
    --hero-below-guess: 0px;
  }

  /* The fade runs straight into the first This week row: no stripe band between them (only when
     This week has no heading of its own). Its bottom padding still counts in the measurement. */
  .shopify-section:has(.pattern-hero--fill .pattern-hero__fade) + .shopify-section .pattern-this-week__inner:not(:has(.pattern-this-week__heading)) {
    padding-top: 0;
  }

  /* ===== Parallax (Subtle): the image layer only; the overlay and fade stay put =====
     Scaled from the bottom edge so it reaches 20% of the hero's height above it; the script moves
     it down by up to that much as the page scrolls, so no edge ever shows. Tablets and up only,
     never with reduced motion. */
  @media screen and (min-width: 750px) and (prefers-reduced-motion: no-preference) {
    .pattern-hero--parallax .pattern-hero__bg picture {
      transform: scale(1.2);
      transform-origin: 50% 100%;
      will-change: transform;
    }
  }

  /* Top / bottom padding settings; the content is centred in whatever height is left */
  .pattern-hero__content-wrap {
    position: relative;
    padding-top: var(--hero-pad-top, 4.8rem);
    padding-bottom: var(--hero-pad-bottom, 4.8rem);
  }

  .pattern-hero__content {
    max-width: 64rem;
    display: flex;
    flex-direction: column;
    gap: 2.4rem;
  }

  .pattern-hero--full .pattern-hero__eyebrow {
    color: var(--pattern-paper-soft);
  }

  .pattern-hero--full .pattern-hero__main {
    gap: 2.8rem;
  }

  @media screen and (max-width: 749px) {
    .pattern-hero--full {
      min-height: var(--hero-h-mobile, 420px);
      justify-content: flex-end;
    }

    .pattern-hero__bg-image {
      object-position: var(--hero-focal-mobile, var(--hero-focal, center));
    }

    /* Phones: stronger overlay, darkest at the bottom where the text sits */
    .pattern-hero--full .pattern-hero__overlay {
      background: linear-gradient(
        0deg,
        rgba(20, 20, 19, var(--hero-a-mobile)) 0%,
        rgba(20, 20, 19, var(--hero-a-mobile)) 50%,
        rgba(20, 20, 19, var(--hero-a-mid)) 100%
      );
    }

    .pattern-hero__content-wrap {
      padding-top: calc(var(--hero-pad-top, 4.8rem) * 2 / 3);
      padding-bottom: calc(var(--hero-pad-bottom, 4.8rem) * 2 / 3);
    }
  }

  /* ===== Split layout ===== */
  .pattern-hero--split {
    display: flex;
    flex-wrap: wrap;
  }

  /* The background is full-bleed, but the text starts on the same line as the header and the
     sections below (.pattern-wrap: max width + gutter, centred). 100cqw = the hero's width. */
  .pattern-hero__text {
    --hero-inset: max(var(--pattern-gutter), calc((100cqw - var(--pattern-wrap-max)) / 2 + var(--pattern-gutter)));
    flex: 1 1 56rem;
    box-sizing: border-box;
    min-width: 0;
    min-height: 56rem;
    padding: 5.6rem var(--pattern-gutter) 4rem var(--hero-inset);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4.8rem;
  }

  .pattern-hero__eyebrow {
    color: var(--pattern-paper-dim);
  }

  .pattern-hero__main {
    display: flex;
    flex-direction: column;
    gap: 3.2rem;
  }

  .pattern-hero__headline {
    font-size: clamp(4rem, 5.2vw, 7.6rem);
    line-height: 0.9;
    color: inherit;
    overflow-wrap: break-word;
  }

  .pattern-hero__body {
    margin: 0;
    max-width: 47rem;
    font-size: 1.8rem;
    line-height: 1.5;
    color: var(--pattern-paper-soft);
  }

  .pattern-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 2.8rem;
  }

  .pattern-hero__secondary {
    font-size: 1.6rem;
    color: var(--pattern-paper);
  }

  .pattern-hero__ctas a[hidden] {
    display: none;
  }

  /* Phones: the button on its own line, the text links together on the next */
  @media screen and (max-width: 749px) {
    .pattern-hero__ctas > .pattern-button:not(:last-child) {
      flex-shrink: 0;
      margin-right: 100%;
    }
  }

  .pattern-hero__media {
    position: relative;
    flex: 1 1 38rem;
    min-width: 0;
    min-height: 56rem;
    overflow: hidden;
  }

  .pattern-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pattern-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--pattern-ink);
    opacity: 0;
    pointer-events: none;
  }

  /* Image on the left: desktop only (text stays first on mobile) */
  @media screen and (min-width: 990px) {
    .pattern-hero--image-left .pattern-hero__media {
      order: -1;
    }

    /* Text on the right: align its far edge with the container instead */
    .pattern-hero--image-left .pattern-hero__text {
      padding-left: var(--pattern-gutter);
      padding-right: var(--hero-inset);
    }
  }

  @media screen and (max-width: 749px) {
    .pattern-hero__text {
      min-height: 0;
      padding-top: 4rem;
      padding-bottom: 3.2rem;
      gap: 4rem;
    }

    .pattern-hero__body {
      font-size: 1.7rem;
    }

    .pattern-hero__media {
      flex-basis: 100%;
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pattern hero",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "full", "label": "Full image" },
        { "value": "split", "label": "Split" }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Record shop & cultural space — Alcântara, Lisboa"
    },
    {
      "type": "text",
      "id": "headline_start",
      "label": "Headline: before the accent word",
      "default": "New cuts"
    },
    {
      "type": "text",
      "id": "headline_accent",
      "label": "Headline: accent word (italic)",
      "default": "for"
    },
    {
      "type": "text",
      "id": "headline_end",
      "label": "Headline: after the accent word",
      "default": "curious listeners"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "House, jazz, disco, dub, soul and more — new and used vinyl, in Alcântara and online."
    },
    {
      "type": "header",
      "content": "Buttons"
