    {
      "type": "range",
      "id": "full_padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "info": "Space above the label. Phones use two thirds.",
      "default": 48
    },
    {
      "type": "range",
      "id": "full_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "info": "Space below the buttons. Phones use two thirds.",
      "default": 48
    },
    {
      "type": "range",
      "id": "full_overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay strength",
      "info": "The side with the text is made darker than this so light text stays readable.",
      "default": 55
    },
    {
      "type": "select",
      "id": "overlay_direction",
      "label": "Overlay direction",
      "options": [
        { "value": "left", "label": "Left to right (darker behind the text)" },
        { "value": "bottom", "label": "Bottom to top" },
        { "value": "even", "label": "Even" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "bottom_fade",
      "label": "Fade into the section below",
      "info": "Blends the bottom of the photo into the dark stripe texture used by \"This week\".",
      "default": true
    },
    {
      "type": "header",
      "content": "Split layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image side",
      "info": "Desktop only. On mobile the image sits below the text.",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Charcoal overlay strength",
      "info": "Split layout.",
      "default": 0
    }
  ],
  "presets": [
    { "name": "Pattern hero" }
  ]
}
{% endschema %}
