{%- comment -%}
  404: display-font heading, one line of text, a primary accent button (new arrivals) and a text
  link to all records. Same container and heading style as the other Pattern pages.
  Styles: assets/pattern-account.css.
{%- endcomment -%}
{{ 'pattern-account.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign primary_url = section.settings.button_link
  if primary_url == blank
    assign primary_url = routes.all_products_collection_url
    if collections['new-in-electronic'].products_count > 0
      assign primary_url = collections['new-in-electronic'].url
    endif
  endif
-%}
<div class="pattern-notfound">
  <p class="pattern-notfound__label">404</p>
  <h1 class="pattern-notfound__title">{{ section.settings.heading | escape }}</h1>
  {%- if section.settings.text != blank -%}
    <p class="pattern-notfound__text">{{ section.settings.text | escape }}</p>
  {%- endif -%}
  <div class="pattern-notfound__actions">
    <a href="{{ primary_url }}" class="pattern-button">{{ section.settings.button_label | escape }}</a>
    <a href="{{ routes.all_products_collection_url }}" class="pattern-text-link">{{ section.settings.link_label | escape }}</a>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "That record isn't here."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "The page may have moved, or the record has found a new home."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty for the New in Electronic collection (or all records)."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Second link label",
      "info": "Links to all records.",
      "default": "Browse by genre"
    }
  ]
}
{% endschema %}
