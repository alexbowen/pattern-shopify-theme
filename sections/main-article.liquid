{%- comment -%}
  Article (Pattern): header with a DM Mono meta line (date, author, tags) and the title in the
  display font, the featured image across the container (wide ratio, capped height; the dark stripe
  texture when there's none), the body in one reading column (assets/pattern-pages.css, shared with
  the info pages) with article extras in assets/pattern-blog.css, then a footer: tags as pills, back
  link, newer / older posts, "More from the shop" (latest other posts as Pattern article cards)
  and comments (only when the blog has them on). Blocks are kept, so the order stays editable.
{%- endcomment -%}
{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
{{ 'pattern-pages.css' | asset_url | stylesheet_tag }}
{{ 'pattern-blog.css' | asset_url | stylesheet_tag }}

<article class="article-template pattern-article">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div class="page-width pattern-page">
          {% render block %}
        </div>

      {%- when 'title' -%}
        <header class="page-width pattern-page pattern-article__header" {{ block.shopify_attributes }}>
          {%- liquid
            assign show_date = block.settings.blog_show_date
            assign show_author = false
            if block.settings.blog_show_author and article.author != blank
              assign show_author = true
            endif
          -%}
          {%- if show_date or show_author or article.tags.size > 0 -%}
            <p class="pattern-label pattern-article__meta">
              {%- if show_date -%}
                {{- article.published_at | time_tag: format: 'date' -}}
              {%- endif -%}
              {%- if show_author -%}
                {%- if show_date %}<span aria-hidden="true"> · </span>{% endif -%}
                <span>{{ article.author | escape }}</span>
              {%- endif -%}
              {%- if article.tags.size > 0 -%}
                {%- if show_date or show_author %}<span aria-hidden="true"> · </span>{% endif -%}
                {%- for tag in article.tags -%}
                  {%- assign tag_handle = tag | handleize -%}
                  <a href="{{ blog.url }}/tagged/{{ tag_handle }}" class="pattern-article__meta-tag">{{ tag | escape }}</a>
                  {%- unless forloop.last %}, {% endunless -%}
                {%- endfor -%}
              {%- endif -%}
            </p>
          {%- endif -%}
          <h1 class="pattern-article__title">{{ article.title | escape }}</h1>
        </header>

      {%- when 'featured_image' -%}
        <div class="pattern-wrap pattern-article__hero" {{ block.shopify_attributes }}>
          <div class="pattern-article__hero-frame{% if article.image == blank %} pattern-stripe-dark{% endif %}">
            {%- if article.image -%}
              {{
                article.image
                | image_url: width: 2400
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '375, 750, 1100, 1500, 2000, 2400',
                  sizes: '(min-width: 1440px) 1344px, calc(100vw - 4rem)',
                  alt: article.image.alt,
                  class: 'pattern-article__hero-image'
              }}
            {%- endif -%}
          </div>
        </div>

      {%- when 'content' -%}
        <div class="page-width pattern-page pattern-article__content" {{ block.shopify_attributes }}>
          <div class="rte">
            {{ article.content }}
          </div>
        </div>

      {%- when 'share' -%}
        <div class="page-width pattern-page pattern-article__share" {{ block.shopify_attributes }}>
          {% assign share_url = request.origin | append: article.url %}
          {% render 'share-button', block: block, share_link: share_url %}
        </div>
    {%- endcase -%}
  {%- endfor -%}

  <footer class="page-width pattern-page pattern-article__footer">
    {%- if article.tags.size > 0 -%}
      {{ 'component-genre-pills.css' | asset_url | stylesheet_tag }}
      <ul class="pattern-blog__tag-list pattern-article__tags" role="list" aria-label="{{ 'blogs.article.pattern_tags' | t | escape }}">
        {%- for tag in article.tags -%}
          {%- assign tag_handle = tag | handleize -%}
          <li>
            <a href="{{ blog.url }}/tagged/{{ tag_handle }}" class="genre-pill"><span class="genre-pill__label">{{ tag | escape }}</span></a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <nav class="pattern-article__nav" aria-label="{{ 'blogs.article.pattern_post_navigation' | t | escape }}">
      <a href="{{ blog.url }}" class="pattern-link pattern-article__back">
        {% render 'pattern-arrow' %}
        {{- 'blogs.article.pattern_back' | t: title: blog.title -}}
      </a>
      {%- if blog.previous_article or blog.next_article -%}
        <div class="pattern-article__pager">
          {%- if blog.previous_article -%}
            <a href="{{ blog.previous_article.url }}" class="pattern-article__pager-link pattern-article__pager-link--prev">
              <span class="pattern-label">{{ 'blogs.article.pattern_previous' | t }}</span>
              <span class="pattern-article__pager-title">{{ blog.previous_article.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if blog.next_article -%}
            <a href="{{ blog.next_article.url }}" class="pattern-article__pager-link pattern-article__pager-link--next">
              <span class="pattern-label">{{ 'blogs.article.pattern_next' | t }}</span>
              <span class="pattern-article__pager-title">{{ blog.next_article.title | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </nav>
  </footer>

  {%- liquid
    assign more_count = 0
    for other in blog.articles limit: 4
      if other.id != article.id
        assign more_count = more_count | plus: 1
      endif
    endfor
  -%}
  {%- if more_count > 0 -%}
    <section class="pattern-wrap pattern-article__more" aria-labelledby="ArticleMoreHeading">
      <h2 class="pattern-article__more-heading" id="ArticleMoreHeading">{{ 'blogs.article.pattern_more' | t }}</h2>
      <ul class="pattern-blog__grid" role="list">
        {%- assign shown = 0 -%}
        {%- for other in blog.articles limit: 4 -%}
          {%- if other.id == article.id or shown >= 3 -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          <li class="pattern-blog__item">
            {% render 'pattern-article-card', article: other, blog_title: blog.title, heading_tag: 'h3' %}
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}

  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper pattern-article__comments">
      <div
        id="comments"
        class="page-width page-width--narrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}

          <h2 id="Comments-{{ article.id }}" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span
                    ><span class="caption-with-letter-spacing">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </footer>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchorId %}
            </div>
          {% endpaginate %}
        {%- endif -%}
        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}
          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                <span class="svg-wrapper">
                  {{- 'icon-success.svg' | inline_asset_content -}}
                </span>
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div
            {% if blog.moderated? == false %}
              class="article-template__comments-fields"
            {% endif %}
          >
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >
                <label class="field__label" for="CommentForm-author">
                  {{- 'blogs.article.name' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.name' | t }}
                      {{ form.errors.messages.author }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                <label class="field__label" for="CommentForm-email">
                  {{- 'blogs.article.email' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- 'blogs.article.email' | t }}
                      {{ form.errors.messages.email }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>
              <label class="form__label field__label" for="CommentForm-body">
                {{- 'blogs.article.message' | t }}
                <span aria-hidden="true">*</span></label
              >
            </div>
            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                  {{- 'blogs.article.message' | t }}
                  {{ form.errors.messages.body }}.</span
                >
              </small>
            {%- endif -%}
          </div>
          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script>
  (() => {
    // Short block quotes (one line or so) read as pull quotes in the italic serif; longer ones
    // stay plain. Measured once the text is there.
    document.querySelectorAll('.pattern-article__content blockquote').forEach((quote) => {
      if (quote.textContent.trim().length <= 160) quote.classList.add('is-short');
    });
  })();
</script>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "featured_image",
      "name": "t:sections.main-article.blocks.featured_image.name",
      "limit": 1
    },
    {
      "type": "title",
      "name": "t:sections.main-article.blocks.title.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "blog_show_date",
          "default": true,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_date.label"
        },
        {
          "type": "checkbox",
          "id": "blog_show_author",
          "default": false,
          "label": "t:sections.main-article.blocks.title.settings.blog_show_author.label"
        }
      ]
    },
    {
      "type": "content",
      "name": "t:sections.main-article.blocks.content.name",
      "limit": 1
    },
    {
      "type": "share",
      "name": "t:sections.main-article.blocks.share.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "label": "t:sections.main-article.blocks.share.settings.text.label",
          "default": "t:sections.main-article.blocks.share.settings.text.default"
        }
      ]
    }
  ]
}
{% endschema %}
