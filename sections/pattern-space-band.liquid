{%- comment -%}
  Pattern space band: full-bleed image with a heading (label, italic accent word) and a "What's
  on" list (up to 4 event blocks: date, name, link) plus a link to everything coming up. Without
  an image the band shows the dark striped placeholder. An ink overlay keeps text readable.
{%- endcomment -%}
<section class="pattern-section pattern-space" aria-labelledby="PatternSpaceHeading-{{ section.id }}">
  <div class="pattern-space__media{% if section.settings.image == blank %} pattern-stripe-dark{% endif %}">
    {%- if section.settings.image != blank -%}
      {%- liquid
        assign focal_point = section.settings.image.presentation.focal_point | default: 'center'
        assign image_style = 'object-position: ' | append: focal_point | append: ';'
      -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1500, 1800, 2400, 3000',
          sizes: '100vw',
          alt: section.settings.image.alt,
          class: 'pattern-space__image',
          style: image_style
      }}
    {%- endif -%}
  </div>

  <div class="pattern-wrap pattern-space__inner">
    <div class="pattern-space__intro">
      {%- if section.settings.label != blank -%}
        <p class="pattern-label pattern-space__label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      <h2 class="pattern-display pattern-space__heading" id="PatternSpaceHeading-{{ section.id }}">
        {%- render 'pattern-heading-text',
          start: section.settings.heading,
          accent: section.settings.heading_accent,
          end: section.settings.heading_end
        -%}
      </h2>
    </div>

    {%- if section.blocks.size > 0 or section.settings.link_label != blank -%}
      <div class="pattern-space__events">
        {%- if section.settings.events_label != blank -%}
          <h3 class="pattern-label pattern-space__label pattern-space__events-label" id="PatternSpaceEvents-{{ section.id }}">
            {{- section.settings.events_label | escape -}}
          </h3>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul
            class="pattern-space__list"
            role="list"
            {% if section.settings.events_label != blank %}
              aria-labelledby="PatternSpaceEvents-{{ section.id }}"
            {% endif %}
          >
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="pattern-space__event pattern-space__event--link">
                {%- else -%}
                  <div class="pattern-space__event">
                {%- endif -%}
                {%- if block.settings.date != blank -%}
                  <span class="pattern-space__date">{{ block.settings.date | escape }}</span>
                {%- endif -%}
                <span class="pattern-space__name">{{ block.settings.name | escape }}</span>
                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="pattern-link pattern-space__all">
            {{- section.settings.link_label | escape -}}
            {% render 'pattern-arrow' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- style -%}
  #shopify-section-{{ section.id }} .pattern-space__media::after {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

{% stylesheet %}
  .pattern-space {
    position: relative;
    isolation: isolate;
    min-height: 62rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background-color: var(--pattern-ink);
    color: var(--pattern-paper);
  }

  .pattern-space__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .pattern-space__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Ink overlay, strongest at the bottom where the text sits */
  .pattern-space__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--pattern-ink) 0%, transparent 75%);
    pointer-events: none;
  }

  .pattern-space__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 4rem 6.4rem;
    padding-top: 6.4rem;
    padding-bottom: 5.6rem;
  }

  .pattern-space__intro {
    flex: 1 1 48rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .pattern-space__label {
    color: var(--pattern-paper-dim);
  }

  .pattern-space__heading {
    font-size: clamp(4.4rem, 6vw, 9.6rem);
    line-height: 0.92;
    overflow-wrap: break-word;
  }

  .pattern-space__events {
    flex: 0 1 42rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .pattern-space__events-label {
    padding-bottom: 1.2rem;
  }

  .pattern-space__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pattern-space__event {
    display: flex;
    gap: 2.4rem;
    align-items: baseline;
    min-height: 4.4rem;
    box-sizing: border-box;
    padding: 1.6rem 0;
    border-top: 0.1rem solid var(--pattern-hairline-on-dark);
    color: inherit;
    text-decoration: none;
  }

  .pattern-space__event--link:hover .pattern-space__name {
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  .pattern-space__date {
    flex: 0 0 auto;
    min-width: 7.2rem;
    font-family: var(--font-mono);
    font-size: 1.3rem;
    color: var(--pattern-paper-dim);
  }

  .pattern-space__name {
    font-size: 1.7rem;
    font-weight: 500;
  }

  .pattern-space__all {
    align-self: flex-start;
    margin-top: 0.4rem;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .pattern-space {
      min-height: 56rem;
    }

    .pattern-space__inner {
      padding-top: 4.8rem;
      padding-bottom: 4rem;
    }

    .pattern-space__events {
      flex-basis: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pattern space band",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Full width. Set a focal point to control the crop. Without an image the band shows a dark striped placeholder."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Ink overlay strength",
      "info": "A fade from the bottom that keeps the text readable over the image.",
      "default": 70
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The space"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading: before the accent word",
      "default": "A room for records, and for"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading: accent word (italic)",
      "default": "people"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading: after the accent word",
      "default": "."
    },
    {
      "type": "header",
      "content": "What's on"
    },
    {
      "type": "text",
      "id": "events_label",
      "label": "List label",
      "default": "What's on"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "See everything coming up"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "The link hides until this is set."
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "info": "e.g. 21 Nov",
          "default": "21 Nov"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "e.g. Listening session — 19:00",
          "default": "Event name — 19:00"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pattern space band",
      "blocks": [
        { "type": "event" },
        { "type": "event" },
        { "type": "event" }
      ]
    }
  ]
}
{% endschema %}
