{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}


{%- comment -%}
  Pattern cart (styles: assets/pattern-cart.css). Records as rows: cover, artist / title, label,
  format · genre, unit price + condition tag (as on the cards), a stepper (only when more copies
  can be added) and Remove, and the line total on the right. The ids, classes and inputs cart.js relies on are kept:
  #CartItem-N.cart-item, #Quantity-N (name updates[]), cart-remove-button, #Line-item-error-N,
  .loading__spinner and the .js-contents wrapper it re-renders. On desktop this section and the
  summary (main-cart-footer) sit side by side.
{%- endcomment -%}
{{ 'pattern-cart.css' | asset_url | stylesheet_tag }}
{%- style -%}
  :root {
    --pattern-cart-pad-top: {{ section.settings.padding_top }}px;
  }
{%- endstyle -%}

<cart-items class="pattern-cart gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width">
    <div class="pattern-cart__head">
      <h1 class="pattern-cart__title">{{ 'sections.cart.title' | t }}</h1>
    </div>

    {%- comment -%} Empty cart (Dawn shows .cart__warnings while cart-items has .is-empty) {%- endcomment -%}
    <div class="cart__warnings pattern-cart-empty">
      <h2 class="pattern-cart-empty__title">{{ 'sections.cart.empty' | t }}</h2>
      {%- if section.settings.empty_text != blank -%}
        <p class="pattern-cart-empty__text">{{ section.settings.empty_text | escape }}</p>
      {%- endif -%}
      {%- liquid
        assign empty_url = section.settings.empty_button_link
        if empty_url == blank
          assign empty_url = collections['new-in-electronic'].url | default: routes.all_products_collection_url
          if collections['new-in-electronic'].products_count == 0
            assign empty_url = routes.all_products_collection_url
          endif
        endif
      -%}
      <div class="pattern-cart-empty__actions">
        <a href="{{ empty_url }}" class="pattern-button">{{ section.settings.empty_button_label | escape }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="pattern-text-link">{{ section.settings.empty_link_label | escape }}</a>
      </div>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <p class="pattern-cart-empty__login">
          {{ 'sections.cart.login.title' | t }}
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <h2 class="visually-hidden">{{ 'sections.cart.caption' | t }}</h2>
            <ul class="pattern-cart-items" role="list">
              {%- for item in cart.items -%}
                {%- liquid
                  assign line = item.index | plus: 1
                  # More copies can be added unless stock (tracked, no overselling) or a max rule stops it.
                  assign can_raise = true
                  if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' and item.variant.inventory_quantity <= item.quantity
                    assign can_raise = false
                  endif
                  if item.variant.quantity_rule.max != null and item.quantity >= item.variant.quantity_rule.max
                    assign can_raise = false
                  endif
                  # A stepper is still needed to go down when more than one copy is in the cart and
                  # the quantity can change in steps.
                  assign show_stepper = can_raise
                  if item.quantity > 1 and item.variant.quantity_rule.increment == 1
                    assign show_stepper = true
                  endif
                -%}
                <li class="cart-item pattern-cart-item" id="CartItem-{{ line }}">
                  <a href="{{ item.url }}" class="pattern-cart-item__media" aria-hidden="true" tabindex="-1">
                    {%- if item.image -%}
                      {{
                        item.image
                        | image_url: width: 240
                        | image_tag: loading: 'lazy', widths: '96, 144, 192, 240', sizes: '(min-width: 750px) 96px, 72px', alt: '', class: 'pattern-cart-item__image'
                      }}
                    {%- endif -%}
                  </a>

                  <div class="pattern-cart-item__details">
                    {%- liquid
                      assign unit_price = item.final_price | money
                      assign unit_compare = ''
                      if item.original_price != item.final_price
                        assign unit_compare = item.original_price | money
                      endif
                    -%}
                    {% render 'pattern-cart-record', product: item.product, url: item.url, price: unit_price, compare_price: unit_compare %}
                    {%- if item.variant.available and item.unit_price_measurement -%}
                      <p class="unit-price caption pattern-cart-item__unit-measure">
                        <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                        {{ item.unit_price | money }}
                        <span aria-hidden="true">/</span>
                        <span class="visually-hidden">&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
                        {%- if item.unit_price_measurement.reference_value != 1 -%}
                          {{- item.unit_price_measurement.reference_value -}}
                        {%- endif -%}
                        {{ item.unit_price_measurement.reference_unit }}
                      </p>
                    {%- endif -%}

                    {%- if item.product.has_only_default_variant == false
                      or item.properties.size != 0
                      or item.selling_plan_allocation != null
                    -%}
                      <dl class="pattern-cart-item__options">
                        {%- if item.product.has_only_default_variant == false -%}
                          {%- for option in item.options_with_values -%}
                            <div class="product-option">
                              <dt>{{ option.name }}:</dt>
                              <dd>{{ option.value }}</dd>
                            </div>
                          {%- endfor -%}
                        {%- endif -%}
                        {%- for property in item.properties -%}
                          {%- assign property_first_char = property.first | slice: 0 -%}
                          {%- if property.last != blank and property_first_char != '_' -%}
                            <div class="product-option">
                              <dt>{{ property.first }}:</dt>
                              <dd>
                                {%- if property.last contains '/uploads/' -%}
                                  <a href="{{ property.last }}" class="link" target="_blank">
                                    {{ property.last | split: '/' | last }}
                                  </a>
                                {%- else -%}
                                  {{ property.last }}
                                {%- endif -%}
                              </dd>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </dl>
                      {%- if item.selling_plan_allocation != null -%}
                        <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}
                    {%- endif -%}

                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discounts__discount">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                            {{ discount.discount_application.title | escape }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                  <div class="pattern-cart-item__actions">
                    <div class="pattern-cart-item__controls">
                      {%- if show_stepper -%}
                        <label class="visually-hidden" for="Quantity-{{ line }}">
                          {{ 'products.product.quantity.label' | t }}
                        </label>
                        <quantity-input class="quantity cart-quantity pattern-cart-qty">
                          <button class="quantity__button" name="minus" type="button">
                            <span class="visually-hidden">
                              {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                            </span>
                            <span class="svg-wrapper">
                              {{- 'icon-minus.svg' | inline_asset_content -}}
                            </span>
                          </button>
                          <input
                            class="quantity__input"
                            data-quantity-variant-id="{{ item.variant.id }}"
                            type="number"
                            name="updates[]"
                            value="{{ item.quantity }}"
                            {% # theme-check-disable %}
                            data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                            min="0"
                            data-min="{{ item.variant.quantity_rule.min }}"
                            {% if item.variant.quantity_rule.max != null %}
                              max="{{ item.variant.quantity_rule.max }}"
                            {% endif %}
                            step="{{ item.variant.quantity_rule.increment }}"
                            {% # theme-check-enable %}
                            aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                            id="Quantity-{{ line }}"
                            data-index="{{ line }}"
                          >
                          <button class="quantity__button" name="plus" type="button"{% unless can_raise %} disabled{% endunless %}>
                            <span class="visually-hidden">
                              {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                            </span>
                            <span class="svg-wrapper">
                              {{- 'icon-plus.svg' | inline_asset_content -}}
                            </span>
                          </button>
                        </quantity-input>
                      {%- else -%}
                        {%- comment -%} No stepper (no more copies can be added): just Remove. The hidden input keeps updates[] and cart.js's #Quantity-N. {%- endcomment -%}
                        <input
                          type="hidden"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          id="Quantity-{{ line }}"
                          data-index="{{ line }}"
                          data-quantity-variant-id="{{ item.variant.id }}"
                        >
                      {%- endif -%}
                      <cart-remove-button id="Remove-{{ line }}" data-index="{{ line }}">
                        <a
                          href="{{ item.url_to_remove }}"
                          class="pattern-text-link pattern-cart-item__remove"
                          aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                        >
                          {{- 'sections.cart.pattern_remove' | t -}}
                        </a>
                      </cart-remove-button>
                    </div>

                    {%- if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null -%}
                      <p class="pattern-cart-item__rules">
                        {%- if item.variant.quantity_rule.increment > 1 -%}
                          {{ 'products.product.quantity.multiples_of' | t: quantity: item.variant.quantity_rule.increment }}
                        {%- endif -%}
                        {%- if item.variant.quantity_rule.min > 1 %}
                          {{ 'products.product.quantity.min_of' | t: quantity: item.variant.quantity_rule.min }}
                        {%- endif -%}
                        {%- if item.variant.quantity_rule.max != null %}
                          {{ 'products.product.quantity.max_of' | t: quantity: item.variant.quantity_rule.max }}
                        {%- endif -%}
                      </p>
                    {%- endif -%}

                    <div class="cart-item__error pattern-cart-item__error" id="Line-item-error-{{ line }}" role="alert">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      <small class="cart-item__error-text"></small>
                    </div>
                    {%- render 'loading-spinner' -%}
                  </div>

                  {%- comment -%} Line total, every row {%- endcomment -%}
                  <div class="cart-item__totals pattern-cart-item__total">
                    <div class="cart-item__price-wrapper">
                      {%- if item.original_line_price != item.final_line_price -%}
                        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                        <s class="pattern-cart-item__old-price">{{ item.original_line_price | money }}</s>
                        <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                      {%- endif -%}
                      <span class="pattern-cart-item__price">{{ item.final_line_price | money }}</span>
                    </div>
                  </div>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text",
      "default": "Nothing in here yet. This week's new arrivals are a good place to start."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "empty_button_link",
      "label": "Button link",
      "info": "Leave empty for the New in Electronic collection (or all records)."
    },
    {
      "type": "text",
      "id": "empty_link_label",
      "label": "Second link label",
      "info": "Links to all records.",
      "default": "Browse by genre"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
