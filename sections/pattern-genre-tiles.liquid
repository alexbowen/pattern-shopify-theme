{%- comment -%}
  Pattern "Browse by genre": heading (with italic accent word), intro, link to all records, genre
  tiles (one block each) and an origin line.

  Tiles sit in four ranked rows set by block position: blocks 1-3 row 1, 4-7 row 2, 8-12 row 3,
  13 onwards row 4. Each row has one tile size and type size (largest first) and a fixed tone:
  rows 1-2 ink, rows 3-4 clay. Reordering blocks in the editor re-ranks the grid.

  Each tile links to the collection with the custom.pattern_genre filter pre-selected: the genre
  handle (the block's handle setting, or its label handleized) is looked up in the pattern_genre metaobjects and its ID becomes the filter value.
  A block link setting overrides that. Counts are a plain text setting (Liquid can't count
  products by metafield), hidden when empty.

  The origin line links to the collection with custom.origin pre-selected for each listed origin.
{%- endcomment -%}
{%- liquid
  assign base_collection = section.settings.collection
  assign base_url = base_collection.url | default: routes.all_products_collection_url
  assign all_url = section.settings.link | default: base_url
-%}

<section class="pattern-section pattern-genres" id="browse-by-genre" aria-labelledby="PatternGenresHeading-{{ section.id }}">
  <div class="pattern-wrap pattern-genres__inner">
    <div class="pattern-genres__head">
      <div class="pattern-genres__intro">
        <h2 class="pattern-display pattern-genres__heading" id="PatternGenresHeading-{{ section.id }}">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_accent != blank %}
            <span class="pattern-accent-word">{{ section.settings.heading_accent | escape }}</span>
          {%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="pattern-genres__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ all_url }}" class="pattern-link">
          {{- section.settings.link_label | escape -}}
          {% render 'pattern-arrow' %}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="pattern-genres__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            # Row from position: 1-3, 4-7, 8-12, then 13+ (row 4 wraps if more blocks are added).
            # A new <ul> opens at each row's first block.
            assign i = forloop.index
            if i <= 3
              assign row = 1
              assign row_start = 1
            elsif i <= 7
              assign row = 2
              assign row_start = 4
            elsif i <= 12
              assign row = 3
              assign row_start = 8
            else
              assign row = 4
              assign row_start = 13
            endif

            assign genre_handle = block.settings.genre_handle | default: block.settings.label | handleize
            assign tile_url = block.settings.link
            if tile_url == blank and genre_handle != blank
              assign genre = metaobjects.pattern_genre[genre_handle]
              if genre != blank
                assign genre_gid = 'gid://shopify/Metaobject/' | append: genre.system.id
                assign tile_url = base_url | append: '?filter.p.m.custom.pattern_genre=' | append: genre_gid
              endif
            endif
            if tile_url == blank
              assign tile_url = base_url
            endif
          -%}
          {%- if i == row_start -%}
            {%- unless forloop.first -%}</ul>{%- endunless -%}
            <ul class="pattern-genres__row pattern-genres__row--{{ row }}" role="list">
          {%- endif -%}
          <li class="pattern-genres__cell" {{ block.shopify_attributes }}>
            <a href="{{ tile_url }}" class="pattern-genre-tile pattern-genre-tile--row-{{ row }}">
              {%- comment -%} Name first in the DOM so the link reads "House, 614 records"; CSS puts the count on top. {%- endcomment -%}
              <span class="pattern-genre-tile__name">{{ block.settings.label | escape }}</span>
              <span class="pattern-genre-tile__top">
                {%- if block.settings.count != blank -%}
                  <span class="pattern-genre-tile__count"><span class="visually-hidden">, </span>{{ block.settings.count | escape }}</span>
                {%- endif -%}
                <svg class="pattern-genre-tile__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M4 12L12 4M5 4h7v7"/></svg>
              </span>
            </a>
          </li>
        {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- assign origins = section.settings.origins | newline_to_br | split: '<br />' -%}
    {%- if section.settings.origins != blank or section.settings.origins_all_label != blank -%}
      <div class="pattern-genres__origins">
        {%- if section.settings.origins_label != blank -%}
          <span class="pattern-label pattern-genres__origins-label" id="PatternOriginsLabel-{{ section.id }}">{{ section.settings.origins_label | escape }}</span>
        {%- endif -%}
        <ul class="pattern-genres__origin-list" role="list" aria-labelledby="PatternOriginsLabel-{{ section.id }}">
          {%- for origin in origins -%}
            {%- assign origin_name = origin | strip -%}
            {%- if origin_name == blank -%}{%- continue -%}{%- endif -%}
            <li>
              <a
                href="{{ base_url }}?filter.p.m.custom.origin={{ origin_name | url_encode }}"
                class="pattern-origin-chip"
              >
                {{- origin_name | escape -}}
              </a>
            </li>
          {%- endfor -%}
          {%- if section.settings.origins_all_label != blank -%}
            <li>
              <a href="{{ section.settings.origins_all_link | default: base_url }}" class="pattern-origin-chip pattern-origin-chip--all">
                {{- section.settings.origins_all_label | escape -}}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pattern-genres__inner {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-top: 2.4rem;
    padding-bottom: var(--pattern-section-space);
  }

  .pattern-genres__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.6rem;
  }

  .pattern-genres__intro {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .pattern-genres__heading {
    font-size: clamp(4rem, 5vw, 7.2rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .pattern-genres__text {
    margin: 0;
    max-width: 52rem;
    font-size: 1.7rem;
    line-height: 1.5;
    color: var(--pattern-muted);
  }

  /* One grid per row: three across, then four, then five and five */
  .pattern-genres__grid {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .pattern-genres__row {
    display: grid;
    grid-template-columns: repeat(var(--genre-cols), minmax(0, 1fr));
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pattern-genres__row--1 { --genre-cols: 3; }
  .pattern-genres__row--2 { --genre-cols: 4; }
  .pattern-genres__row--3,
  .pattern-genres__row--4 { --genre-cols: 5; }

  .pattern-genre-tile {
    display: flex;
    flex-direction: column-reverse;
    justify-content: space-between;
    gap: 1.6rem;
    box-sizing: border-box;
    height: 100%;
    padding: 2rem 2.2rem;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .pattern-genre-tile:hover {
    transform: translateY(-0.3rem);
  }

  /* Tone by row: 1-2 ink, 3-4 clay */
  .pattern-genre-tile--row-1,
  .pattern-genre-tile--row-2 {
    background-color: var(--pattern-ink);
    color: var(--pattern-paper);
  }

  .pattern-genre-tile--row-3,
  .pattern-genre-tile--row-4 {
    background-color: var(--pattern-clay);
    color: var(--pattern-ink);
  }

  .pattern-genre-tile__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.2rem;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .pattern-genre-tile__icon {
    flex: 0 0 auto;
    margin-left: auto;
    width: 1.6rem;
    height: 1.6rem;
  }

  .pattern-genre-tile__name {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    overflow-wrap: break-word;
  }

  /* Size by row, stepping down */
  .pattern-genre-tile--row-1 { min-height: 30rem; }
  .pattern-genre-tile--row-1 .pattern-genre-tile__name { font-size: clamp(5.6rem, 6vw, 8.8rem); }
  .pattern-genre-tile--row-2 { min-height: 22rem; }
  .pattern-genre-tile--row-2 .pattern-genre-tile__name { font-size: clamp(3.6rem, 3.6vw, 5.2rem); }
  .pattern-genre-tile--row-3 { min-height: 17rem; }
  .pattern-genre-tile--row-3 .pattern-genre-tile__name { font-size: clamp(2.8rem, 2.5vw, 3.6rem); }
  .pattern-genre-tile--row-4 { min-height: 14rem; }
  .pattern-genre-tile--row-4 .pattern-genre-tile__name { font-size: clamp(2.4rem, 2vw, 2.8rem); }

  /* Origin line */
  .pattern-genres__origins {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
  }

  .pattern-genres__origins-label {
    margin-right: 0.8rem;
    color: var(--pattern-muted);
  }

  .pattern-genres__origin-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pattern-origin-chip {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    padding: 0 2rem;
    border: 0.1rem solid var(--pattern-ink);
    color: var(--pattern-ink);
    font-family: var(--font-mono);
    font-size: 1.3rem;
    text-decoration: none;
  }

  .pattern-origin-chip:hover {
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  .pattern-origin-chip--all {
    border-style: dashed;
  }

  /* Tablet: row 1 stays three across, row 2 two, rows 3-4 three */
  @media screen and (max-width: 900px) {
    .pattern-genres__row--2 { --genre-cols: 2; }
    .pattern-genres__row--3,
    .pattern-genres__row--4 { --genre-cols: 3; }

    .pattern-genre-tile--row-1 { min-height: 22rem; }
    .pattern-genre-tile--row-2 { min-height: 17rem; }
    .pattern-genre-tile--row-3 { min-height: 14rem; }
    .pattern-genre-tile--row-4 { min-height: 12rem; }
  }

  /* Phone: row 1 one column, row 2 and rows 3-4 two */
  @media screen and (max-width: 560px) {
    .pattern-genres__grid,
    .pattern-genres__row { gap: 1.2rem; }

    .pattern-genres__row--1 { --genre-cols: 1; }
    .pattern-genres__row--2,
    .pattern-genres__row--3,
    .pattern-genres__row--4 { --genre-cols: 2; }

    .pattern-genre-tile { padding: 1.6rem 1.8rem; gap: 1.2rem; }

    .pattern-genre-tile--row-1 { min-height: 16rem; }
    .pattern-genre-tile--row-1 .pattern-genre-tile__name { font-size: 5.6rem; }
    .pattern-genre-tile--row-2 { min-height: 13rem; }
    .pattern-genre-tile--row-2 .pattern-genre-tile__name { font-size: 3.2rem; }
    .pattern-genre-tile--row-3 { min-height: 11rem; }
    .pattern-genre-tile--row-3 .pattern-genre-tile__name { font-size: 2.6rem; }
    .pattern-genre-tile--row-4 { min-height: 10rem; }
    .pattern-genre-tile--row-4 .pattern-genre-tile__name { font-size: 2.2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pattern-genre-tile {
      transition: none;
    }

    .pattern-genre-tile:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pattern genre tiles",
  "tag": "div",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Browse by"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word (italic)",
      "default": "genre"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "Seventeen starting points. Pick one and the sub-genres open up once you are inside."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection the tiles filter",
      "info": "Leave empty for all products."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All records"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Leave empty to link to the collection."
    },
    {
      "type": "header",
      "content": "Origin line"
    },
    {
      "type": "text",
      "id": "origins_label",
      "label": "Label",
      "default": "Or start from a place"
    },
    {
      "type": "textarea",
      "id": "origins",
      "label": "Origins",
      "info": "One per line, exactly as stored in the product's origin field. Each links to the collection filtered by that origin.",
      "default": "Portugal\nBrazil\nJapan"
    },
    {
      "type": "text",
      "id": "origins_all_label",
      "label": "\"All origins\" label",
      "default": "All origins +"
    },
    {
      "type": "url",
      "id": "origins_all_link",
      "label": "\"All origins\" link",
      "info": "Leave empty to link to the collection, where the origin filter lists every origin."
    }
  ],
  "blocks": [
    {
      "type": "genre",
      "name": "Genre tile",
      "settings": [
        {
          "type": "paragraph",
          "content": "Tiles are ranked by position: the first 3 blocks make row 1 (largest), the next 4 row 2, the next 5 row 3, the rest row 4. Drag blocks to re-rank."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Genre label",
          "default": "House"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to link to the collection with this genre selected."
        },
        {
          "type": "text",
          "id": "count",
          "label": "Count text",
          "info": "Optional, e.g. \"614 records\". Not updated automatically; hidden when empty."
        },
        {
          "type": "text",
          "id": "genre_handle",
          "label": "Genre handle",
          "info": "Only needed if the label differs from the Pattern genre's name, e.g. world-music. Used for the default link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pattern genre tiles",
      "blocks": [
        { "type": "genre", "settings": { "label": "House", "count": "614 records" } },
        { "type": "genre", "settings": { "label": "Jazz", "count": "513 records" } },
        { "type": "genre", "settings": { "label": "Techno", "count": "370 records" } },
        { "type": "genre", "settings": { "label": "Disco", "count": "303 records" } },
        { "type": "genre", "settings": { "label": "World Music", "count": "277 records" } },
        { "type": "genre", "settings": { "label": "Rock", "count": "232 records" } },
        { "type": "genre", "settings": { "label": "Funk", "count": "207 records" } },
        { "type": "genre", "settings": { "label": "Soul", "count": "188 records" } },
        { "type": "genre", "settings": { "label": "Electronica", "count": "139 records" } },
        { "type": "genre", "settings": { "label": "Electro", "count": "102 records" } },
        { "type": "genre", "settings": { "label": "Dub", "count": "102 records" } },
        { "type": "genre", "settings": { "label": "Reggae", "count": "81 records" } },
        { "type": "genre", "settings": { "label": "Hip Hop", "count": "80 records" } },
        { "type": "genre", "settings": { "label": "Folk", "count": "55 records" } },
        { "type": "genre", "settings": { "label": "Blues", "count": "24 records" } },
        { "type": "genre", "settings": { "label": "Soundtrack", "count": "9 records" } },
        { "type": "genre", "settings": { "label": "Classical", "count": "5 records" } }
      ]
    }
  ]
}
{% endschema %}
