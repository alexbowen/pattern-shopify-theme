{%- comment -%}
  Pattern "Browse by genre": heading (with italic accent word), intro, link to all records, a
  12-column grid of genre tiles (one block each) and an origin line.

  Each tile links to the collection with the custom.pattern_genre filter pre-selected: the block's
  genre handle is looked up in the pattern_genre metaobjects and its ID becomes the filter value.
  A block link setting overrides that. Counts are a plain text setting (Liquid can't count
  products by metafield), hidden when empty.

  The origin line links to the collection with custom.origin pre-selected for each listed origin.
{%- endcomment -%}
{%- liquid
  assign base_collection = section.settings.collection
  assign base_url = base_collection.url | default: routes.all_products_collection_url
  assign all_url = section.settings.link | default: base_url
-%}

<section class="pattern-section pattern-genres" id="browse-by-genre" aria-labelledby="PatternGenresHeading-{{ section.id }}">
  <div class="pattern-wrap pattern-genres__inner">
    <div class="pattern-genres__head">
      <div class="pattern-genres__intro">
        <h2 class="pattern-display pattern-genres__heading" id="PatternGenresHeading-{{ section.id }}">
          {{- section.settings.heading | escape -}}
          {%- if section.settings.heading_accent != blank %}
            <span class="pattern-accent-word">{{ section.settings.heading_accent | escape }}</span>
          {%- endif -%}
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="pattern-genres__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ all_url }}" class="pattern-link">
          {{- section.settings.link_label | escape -}}
          {% render 'pattern-arrow' %}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="pattern-genres__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tile_url = block.settings.link
            if tile_url == blank and block.settings.genre_handle != blank
              assign genre = metaobjects.pattern_genre[block.settings.genre_handle]
              if genre != blank
                assign genre_gid = 'gid://shopify/Metaobject/' | append: genre.system.id
                assign tile_url = base_url | append: '?filter.p.m.custom.pattern_genre=' | append: genre_gid
              endif
            endif
            if tile_url == blank
              assign tile_url = base_url
            endif
          -%}
          <li
            class="pattern-genres__cell pattern-genres__cell--span-{{ block.settings.width }}"
            {{ block.shopify_attributes }}
          >
            <a
              href="{{ tile_url }}"
              class="pattern-genre-tile pattern-genre-tile--{{ block.settings.style }} pattern-genre-tile--{{ block.settings.size }}"
            >
              {%- comment -%} Name first in the DOM so the link reads "House, 614 records"; CSS puts the count on top. {%- endcomment -%}
              <span class="pattern-genre-tile__name">{{ block.settings.label | escape }}</span>
              <span class="pattern-genre-tile__top">
                {%- if block.settings.count != blank -%}
                  <span class="pattern-genre-tile__count"><span class="visually-hidden">, </span>{{ block.settings.count | escape }}</span>
                {%- else -%}
                  <span></span>
                {%- endif -%}
                <svg class="pattern-genre-tile__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M4 12L12 4M5 4h7v7"/></svg>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- assign origins = section.settings.origins | newline_to_br | split: '<br />' -%}
    {%- if section.settings.origins != blank or section.settings.origins_all_label != blank -%}
      <div class="pattern-genres__origins">
        {%- if section.settings.origins_label != blank -%}
          <span class="pattern-label pattern-genres__origins-label" id="PatternOriginsLabel-{{ section.id }}">{{ section.settings.origins_label | escape }}</span>
        {%- endif -%}
        <ul class="pattern-genres__origin-list" role="list" aria-labelledby="PatternOriginsLabel-{{ section.id }}">
          {%- for origin in origins -%}
            {%- assign origin_name = origin | strip -%}
            {%- if origin_name == blank -%}{%- continue -%}{%- endif -%}
            <li>
              <a
                href="{{ base_url }}?filter.p.m.custom.origin={{ origin_name | url_encode }}"
                class="pattern-origin-chip"
              >
                {{- origin_name | escape -}}
              </a>
            </li>
          {%- endfor -%}
          {%- if section.settings.origins_all_label != blank -%}
            <li>
              <a href="{{ section.settings.origins_all_link | default: base_url }}" class="pattern-origin-chip pattern-origin-chip--all">
                {{- section.settings.origins_all_label | escape -}}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pattern-genres__inner {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-top: 2.4rem;
    padding-bottom: var(--pattern-section-space);
  }

  .pattern-genres__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.6rem;
  }

  .pattern-genres__intro {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .pattern-genres__heading {
    font-size: clamp(4rem, 5vw, 7.2rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .pattern-genres__text {
    margin: 0;
    max-width: 52rem;
    font-size: 1.7rem;
    line-height: 1.5;
    color: var(--pattern-muted);
  }

  /* 12-column grid; tile widths are block settings (2-5 columns) */
  .pattern-genres__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pattern-genres__cell--span-2 { grid-column: span 2; }
  .pattern-genres__cell--span-3 { grid-column: span 3; }
  .pattern-genres__cell--span-4 { grid-column: span 4; }
  .pattern-genres__cell--span-5 { grid-column: span 5; }

  .pattern-genre-tile {
    display: flex;
    flex-direction: column-reverse;
    justify-content: space-between;
    gap: 1.6rem;
    box-sizing: border-box;
    height: 100%;
    min-height: 20rem;
    padding: 2rem 2.2rem;
    border: 0.1rem solid color-mix(in srgb, var(--pattern-ink) 22%, transparent);
    background-color: transparent;
    color: var(--pattern-ink);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .pattern-genre-tile:hover {
    transform: translateY(-0.3rem);
  }

  .pattern-genre-tile--ink {
    background-color: var(--pattern-ink);
    border-color: var(--pattern-ink);
    color: var(--pattern-paper);
  }

  .pattern-genre-tile--clay {
    background-color: var(--pattern-clay);
    border-color: var(--pattern-clay);
    color: var(--pattern-ink);
  }

  .pattern-genre-tile--accent {
    background-color: var(--pattern-accent);
    border-color: var(--pattern-accent);
    color: var(--pattern-on-accent);
  }

  .pattern-genre-tile__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .pattern-genre-tile__icon {
    flex: 0 0 auto;
    margin-left: auto;
    width: 1.6rem;
    height: 1.6rem;
  }

  .pattern-genre-tile__name {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    overflow-wrap: break-word;
    font-size: 3.6rem;
  }

  /* Sizes: tile height + name size, from the mockup */
  .pattern-genre-tile--compact { min-height: 20rem; }
  .pattern-genre-tile--compact .pattern-genre-tile__name { font-size: 2.8rem; }
  .pattern-genre-tile--regular { min-height: 20rem; }
  .pattern-genre-tile--regular .pattern-genre-tile__name { font-size: 3.6rem; }
  .pattern-genre-tile--medium { min-height: 22rem; }
  .pattern-genre-tile--medium .pattern-genre-tile__name { font-size: 4rem; }
  .pattern-genre-tile--large { min-height: 30rem; }
  .pattern-genre-tile--large .pattern-genre-tile__name { font-size: 4.4rem; }
  .pattern-genre-tile--xlarge { min-height: 30rem; }
  .pattern-genre-tile--xlarge .pattern-genre-tile__name { font-size: 6.4rem; }
  .pattern-genre-tile--hero { min-height: 30rem; }
  .pattern-genre-tile--hero .pattern-genre-tile__name { font-size: 8rem; }

  /* Origin line */
  .pattern-genres__origins {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
  }

  .pattern-genres__origins-label {
    margin-right: 0.8rem;
    color: var(--pattern-muted);
  }

  .pattern-genres__origin-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pattern-origin-chip {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    padding: 0 2rem;
    border: 0.1rem solid var(--pattern-ink);
    color: var(--pattern-ink);
    font-family: var(--font-mono);
    font-size: 1.3rem;
    text-decoration: none;
  }

  .pattern-origin-chip:hover {
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  .pattern-origin-chip--all {
    border-style: dashed;
  }

  /* Tablet: two tiles per row */
  @media screen and (max-width: 900px) {
    .pattern-genres__cell--span-2,
    .pattern-genres__cell--span-3,
    .pattern-genres__cell--span-4,
    .pattern-genres__cell--span-5 {
      grid-column: span 6;
    }

    .pattern-genre-tile,
    .pattern-genre-tile--large,
    .pattern-genre-tile--xlarge,
    .pattern-genre-tile--hero {
      min-height: 16rem;
    }

    .pattern-genre-tile--xlarge .pattern-genre-tile__name,
    .pattern-genre-tile--hero .pattern-genre-tile__name {
      font-size: 5.6rem;
    }
  }

  /* Phone: one tile per row, shorter */
  @media screen and (max-width: 560px) {
    .pattern-genres__cell--span-2,
    .pattern-genres__cell--span-3,
    .pattern-genres__cell--span-4,
    .pattern-genres__cell--span-5 {
      grid-column: span 12;
    }

    .pattern-genre-tile,
    .pattern-genre-tile--compact,
    .pattern-genre-tile--regular,
    .pattern-genre-tile--medium,
    .pattern-genre-tile--large,
    .pattern-genre-tile--xlarge,
    .pattern-genre-tile--hero {
      min-height: 12rem;
      padding: 1.6rem 1.8rem;
    }

    .pattern-genre-tile .pattern-genre-tile__name {
      font-size: 3.2rem;
    }

    .pattern-genre-tile--xlarge .pattern-genre-tile__name,
    .pattern-genre-tile--hero .pattern-genre-tile__name {
      font-size: 4.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pattern-genre-tile {
      transition: none;
    }

    .pattern-genre-tile:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pattern genre tiles",
  "tag": "div",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Browse by"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word (italic)",
      "default": "genre"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "Seventeen starting points. Pick one and the sub-genres open up once you are inside."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection the tiles filter",
      "info": "Leave empty for all products."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All records"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Leave empty to link to the collection."
    },
    {
      "type": "header",
      "content": "Origin line"
    },
    {
      "type": "text",
      "id": "origins_label",
      "label": "Label",
      "default": "Or start from a place"
    },
    {
      "type": "textarea",
      "id": "origins",
      "label": "Origins",
      "info": "One per line, exactly as stored in the product's origin field. Each links to the collection filtered by that origin.",
      "default": "Portugal\nBrazil\nJapan"
    },
    {
      "type": "text",
      "id": "origins_all_label",
      "label": "\"All origins\" label",
      "default": "All origins +"
    },
    {
      "type": "url",
      "id": "origins_all_link",
      "label": "\"All origins\" link",
      "info": "Leave empty to link to the collection, where the origin filter lists every origin."
    }
  ],
  "blocks": [
    {
      "type": "genre",
      "name": "Genre tile",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "House"
        },
        {
          "type": "text",
          "id": "genre_handle",
          "label": "Genre handle",
          "info": "Handle of the Pattern genre (e.g. house, world-music). Used to link to the collection with that genre selected.",
          "default": "house"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override",
          "info": "Optional. Replaces the genre link."
        },
        {
          "type": "text",
          "id": "count",
          "label": "Count text",
          "info": "Optional, e.g. \"614 records\". Not updated automatically; hidden when empty."
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width (of 12 columns)",
          "options": [
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" },
            { "value": "5", "label": "5" }
          ],
          "default": "3"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "compact", "label": "Compact" },
            { "value": "regular", "label": "Regular" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" },
            { "value": "xlarge", "label": "Extra large" },
            { "value": "hero", "label": "Hero" }
          ],
          "default": "regular"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "outline", "label": "Outline" },
            { "value": "ink", "label": "Ink" },
            { "value": "clay", "label": "Clay" },
            { "value": "accent", "label": "Accent" }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pattern genre tiles",
      "blocks": [
        { "type": "genre", "settings": { "label": "House", "genre_handle": "house", "width": "5", "size": "hero", "style": "accent" } },
        { "type": "genre", "settings": { "label": "Jazz", "genre_handle": "jazz", "width": "4", "size": "xlarge", "style": "ink" } },
        { "type": "genre", "settings": { "label": "Techno", "genre_handle": "techno", "width": "3", "size": "large", "style": "outline" } }
      ]
    }
  ]
}
{% endschema %}
