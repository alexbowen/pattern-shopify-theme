{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Pattern cart summary (styles: assets/pattern-cart.css): a hairline panel on paper with the
  subtotal, a one-line postage note, the order note behind "Add a note", the Checkout button
  (primary accent), any dynamic checkout buttons and three reassurance lines. Sticky beside the
  items on desktop, below them on mobile, where a bar with the subtotal and Checkout appears at the
  bottom of the screen while the main Checkout button is out of view.
  cart.js re-renders the first .js-contents here (the subtotal) after every change; the cart note
  is cart.js's <cart-note>.
{%- endcomment -%}
{{ 'pattern-cart.css' | asset_url | stylesheet_tag }}

<div
  class="pattern-cart-footer gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate section-{{ section.id }}-padding">
      <div class="cart__blocks pattern-cart-summary">
        {%- assign note_rendered = false -%}
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'subtotal' -%}
              <div class="js-contents pattern-cart-summary__totals" {{ block.shopify_attributes }}>
                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                    {%- for discount in cart.cart_level_discount_applications -%}
                      <li class="discounts__discount discounts__discount--position">
                        {{- 'icon-discount.svg' | inline_asset_content -}}
                        {{ discount.title | escape }}
                        (-{{ discount.total_allocated_amount | money }})
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <div class="totals pattern-cart-summary__subtotal">
                  <h2 class="totals__total">
                    {{- 'sections.cart.pattern_subtotal' | t -}}
                    <span class="pattern-cart-summary__count"> · {{ 'sections.cart.pattern_item_count' | t: count: cart.item_count }}</span>
                  </h2>
                  <p class="totals__total-value" data-pattern-cart-subtotal>{{ cart.total_price | money_with_currency }}</p>
                </div>

                {%- if section.settings.summary_note != blank -%}
                  <p class="pattern-cart-summary__note">{{ section.settings.summary_note | escape }}</p>
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="pattern-cart-summary__actions" {{ block.shopify_attributes }}>
                {%- if settings.show_cart_note and note_rendered == false -%}
                  {%- assign note_rendered = true -%}
                  <details class="pattern-cart-note"{% if cart.note != blank %} open{% endif %}>
                    <summary class="pattern-text-link pattern-cart-note__toggle">{{ 'sections.cart.pattern_add_note' | t }}</summary>
                    <cart-note class="cart__note field pattern-cart-note__field">
                      <label for="Cart-note" class="pattern-cart-note__label">{{ 'sections.cart.note' | t }}</label>
                      <textarea
                        class="text-area field__input pattern-cart-note__input"
                        name="note"
                        form="cart"
                        id="Cart-note"
                        rows="3"
                      >{{ cart.note }}</textarea>
                    </cart-note>
                  </details>
                {%- endif -%}

                <div class="cart__ctas">
                  <button
                    type="submit"
                    id="checkout"
                    class="cart__checkout-button pattern-button pattern-cart-checkout"
                    name="checkout"
                    {% if cart == empty %}
                      disabled
                    {% endif %}
                    form="cart"
                  >
                    {{ 'sections.cart.checkout' | t }}
                  </button>
                </div>

                {%- if additional_checkout_buttons -%}
                  <div class="cart__dynamic-checkout-buttons additional-checkout-buttons pattern-cart-summary__dynamic">
                    {{ content_for_additional_checkout_buttons }}
                  </div>
                {%- endif -%}

                {%- if section.settings.reassurance_1 != blank or section.settings.reassurance_2 != blank or section.settings.reassurance_3 != blank -%}
                  <ul class="pattern-cart-reassurance" role="list">
                    {%- if section.settings.reassurance_1 != blank -%}
                      <li>{% render 'pattern-icon', name: 'parcel', size: 18 %}<span>{{ section.settings.reassurance_1 | escape }}</span></li>
                    {%- endif -%}
                    {%- if section.settings.reassurance_2 != blank -%}
                      <li>{% render 'pattern-icon', name: 'van', size: 18 %}<span>{{ section.settings.reassurance_2 | escape }}</span></li>
                    {%- endif -%}
                    {%- if section.settings.reassurance_3 != blank -%}
                      <li>{% render 'pattern-icon', name: 'storefront', size: 18 %}<span>{{ section.settings.reassurance_3 | escape }}</span></li>
                    {%- endif -%}
                  </ul>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors" class="pattern-cart-errors" role="alert"></div>
      </div>
    </div>
  </div>

  {%- comment -%}
    Mobile: subtotal and Checkout pinned to the bottom of the screen while the main Checkout button
    is out of view (see the script below). Hidden (and inert) otherwise and on wider screens.
  {%- endcomment -%}
  <div class="pattern-cart-bar" data-pattern-cart-bar aria-hidden="true" inert>
    <div class="pattern-cart-bar__total">
      <span class="pattern-cart-bar__label">{{ 'sections.cart.pattern_subtotal' | t }}</span>
      <span class="pattern-cart-bar__value" data-pattern-cart-bar-value>{{ cart.total_price | money_with_currency }}</span>
    </div>
    <button type="submit" class="pattern-button pattern-cart-bar__button" name="checkout" form="cart">
      {{ 'sections.cart.checkout' | t }}
    </button>
  </div>
</div>

<script>
  (() => {
    const bar = document.querySelector('[data-pattern-cart-bar]');
    if (!bar) return;
    const mobile = window.matchMedia('(max-width: 749px)');
    let checkoutVisible = true;
    const setBar = () => {
      const footer = document.getElementById('main-cart-footer');
      const show = mobile.matches && !checkoutVisible && footer && !footer.classList.contains('is-empty');
      bar.classList.toggle('is-visible', Boolean(show));
      bar.setAttribute('aria-hidden', show ? 'false' : 'true');
      bar.inert = !show;
    };
    const checkout = document.getElementById('checkout');
    if (checkout && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        checkoutVisible = entry.isIntersecting;
        setBar();
      }).observe(checkout);
    }
    mobile.addEventListener('change', setBar);

    // Keep the bar's subtotal in step after cart.js re-renders the summary.
    const sync = () => {
      const subtotal = document.querySelector('[data-pattern-cart-subtotal]');
      const value = bar.querySelector('[data-pattern-cart-bar-value]');
      if (subtotal && value) value.textContent = subtotal.textContent.trim();
      setBar();
    };
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
        subscribe(PUB_SUB_EVENTS.cartUpdate, sync);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "summary_note",
      "label": "Note under the subtotal",
      "default": "Postage and any duties are calculated at checkout."
    },
    {
      "type": "header",
      "content": "Reassurance lines"
    },
    {
      "type": "paragraph",
      "content": "Shown under the Checkout button with a parcel, van and shop icon. Leave a line empty to hide it."
    },
    {
      "type": "text",
      "id": "reassurance_1",
      "label": "Line 1",
      "default": "Flat-rate postage in Portugal & Spain"
    },
    {
      "type": "text",
      "id": "reassurance_2",
      "label": "Line 2",
      "default": "Ships across the EU & UK"
    },
    {
      "type": "text",
      "id": "reassurance_3",
      "label": "Line 3",
      "default": "Collect in store"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },    
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
