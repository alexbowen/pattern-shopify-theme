{%- comment -%}
  Pattern column: a container for Pattern blocks (heading, text, button, image, listen list,
  record) with a background (dark stripes, clay stripes, clay, paper or an image with an ink
  overlay), padding, minimum height and vertical alignment. Sets --pattern-surface so listen-card
  play buttons invert correctly on every background.
{%- endcomment -%}
{%- liquid
  assign bg = block.settings.background
  # Opal is never a large fill: an older saved "accent" background shows as clay.
  if bg == 'accent'
    assign bg = 'clay'
  endif
  assign texture_class = ''
  if bg == 'stripes-dark'
    assign texture_class = ' pattern-stripe-dark'
  elsif bg == 'stripes-clay'
    assign texture_class = ' pattern-stripe-clay'
  endif
-%}
<div
  class="pattern-column__inner pattern-column--bg-{{ bg }} pattern-column--pad-{{ block.settings.padding }} pattern-column--align-{{ block.settings.align }} pattern-column--height-{{ block.settings.min_height }}{{ texture_class }}"
  {% if bg == 'image' %}
    style="--column-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
  {% endif %}
>
  {%- if bg == 'image' -%}
    <div class="pattern-column__media{% if block.settings.image == blank %} pattern-stripe-dark{% endif %}">
      {%- if block.settings.image != blank -%}
        {%- liquid
          assign focal_point = block.settings.image.presentation.focal_point | default: 'center'
          assign image_style = 'object-position: ' | append: focal_point | append: ';'
        -%}
        {{
          block.settings.image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            widths: '375, 550, 750, 1100, 1500, 2000',
            sizes: '(min-width: 750px) 50vw, 100vw',
            alt: block.settings.image.alt,
            class: 'pattern-column__image',
            style: image_style
        }}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="pattern-column__content">
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  .pattern-column {
    min-width: 0;
    display: flex;
  }

  .pattern-column__inner {
    --pattern-surface: var(--pattern-paper);
    position: relative;
    isolation: isolate;
    flex: 1 1 auto;
    min-width: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    background-color: var(--pattern-paper);
    color: var(--pattern-ink);
  }

  .pattern-column__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2.8rem;
    min-width: 0;
  }

  /* Backgrounds */
  .pattern-column--bg-stripes-dark,
  .pattern-column--bg-image {
    --pattern-surface: var(--pattern-ink);
    background-color: var(--pattern-ink);
    color: var(--pattern-paper);
  }

  .pattern-column--bg-stripes-clay {
    --pattern-surface: var(--pattern-clay);
    background-color: var(--pattern-clay);
    color: var(--pattern-ink);
  }

  .pattern-column--bg-clay {
    --pattern-surface: var(--pattern-clay);
    background-color: var(--pattern-clay);
    color: var(--pattern-ink);
  }

  .pattern-column__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .pattern-column__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pattern-column__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--pattern-ink);
    opacity: var(--column-overlay, 0.5);
  }

  /* Padding */
  .pattern-column--pad-none { padding: 0; }
  .pattern-column--pad-small { padding: 2.4rem var(--pattern-gutter); }
  .pattern-column--pad-medium { padding: clamp(4rem, 5vw, 7.2rem) clamp(2rem, 4vw, 5.6rem); }
  .pattern-column--pad-large { padding: clamp(5.6rem, 8vw, 12rem) clamp(2rem, 5vw, 7.2rem); }

  /* Vertical alignment */
  .pattern-column--align-top { justify-content: flex-start; }
  .pattern-column--align-center { justify-content: center; }
  .pattern-column--align-bottom { justify-content: flex-end; }

  /* Minimum height */
  .pattern-column--height-medium { min-height: 48rem; }
  .pattern-column--height-tall { min-height: 64rem; }

  @media screen and (max-width: 749px) {
    .pattern-column--height-medium { min-height: 36rem; }
    .pattern-column--height-tall { min-height: 48rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Column",
  "class": "pattern-column",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "stripes-dark", "label": "Stripes, dark" },
        { "value": "stripes-clay", "label": "Stripes, clay" },
        { "value": "clay", "label": "Clay" },
        { "value": "paper", "label": "Paper" },
        { "value": "image", "label": "Image" }
      ],
      "default": "paper"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Used when Background is Image. Set a focal point to control the crop."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Image overlay strength",
      "default": 50
    },
    {
      "type": "select",
      "id": "padding",
      "label": "Padding",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "min_height",
      "label": "Minimum height",
      "options": [
        { "value": "auto", "label": "Fit content" },
        { "value": "medium", "label": "Medium" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "auto"
    }
  ],
  "blocks": [
    { "type": "pattern-heading" },
    { "type": "pattern-text" },
    { "type": "pattern-button" },
    { "type": "pattern-image" },
    { "type": "pattern-listen-list" },
    { "type": "pattern-record" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Column",
      "blocks": [
        { "type": "pattern-heading" },
        { "type": "pattern-text" }
      ]
    }
  ]
}
{% endschema %}
