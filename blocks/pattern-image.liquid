{%- comment -%}
  Pattern image: image with a chosen ratio and its focal point; striped placeholder when empty.
  Alt text comes from the image's own alt setting.
{%- endcomment -%}
<div class="pattern-image-block__frame pattern-image-block--{{ block.settings.ratio }}{% if block.settings.image == blank %} pattern-placeholder{% endif %}">
  {%- if block.settings.image != blank -%}
    {%- liquid
      assign focal_point = block.settings.image.presentation.focal_point | default: 'center'
      assign image_style = 'object-position: ' | append: focal_point | append: ';'
    -%}
    {{
      block.settings.image
      | image_url: width: 1800
      | image_tag:
        loading: 'lazy',
        widths: '375, 550, 750, 1100, 1500, 1800',
        sizes: '(min-width: 750px) 50vw, 100vw',
        alt: block.settings.image.alt,
        class: 'pattern-image-block__image',
        style: image_style
    }}
  {%- endif -%}
</div>

{% stylesheet %}
  .pattern-image-block__frame {
    position: relative;
    overflow: hidden;
  }

  .pattern-image-block--square { aspect-ratio: 1 / 1; }
  .pattern-image-block--landscape { aspect-ratio: 4 / 3; }
  .pattern-image-block--wide { aspect-ratio: 3 / 2; }
  .pattern-image-block--portrait { aspect-ratio: 4 / 5; }

  .pattern-image-block__frame:not(.pattern-image-block--natural) .pattern-image-block__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pattern-image-block--natural .pattern-image-block__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .pattern-image-block--natural.pattern-placeholder {
    aspect-ratio: 4 / 3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image",
  "class": "pattern-image-block",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Set a focal point to control the crop. Without an image a striped placeholder shows."
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Shape",
      "options": [
        { "value": "natural", "label": "Natural" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape 4:3" },
        { "value": "wide", "label": "Wide 3:2" },
        { "value": "portrait", "label": "Portrait 4:5" }
      ],
      "default": "portrait"
    }
  ],
  "presets": [{ "name": "Image" }]
}
{% endschema %}
