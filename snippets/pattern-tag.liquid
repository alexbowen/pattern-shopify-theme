{%- comment -%}
  Small mono tag (11px, uppercase, 1px charcoal border, square corners), shared by the product
  cards and the product page price row. Styles: .pattern-tag in assets/pattern-base.css.

  Accepts:
  - text: {String} tag text (renders nothing when blank)
  - class: {String} extra classes (optional)

  Usage:
  {% render 'pattern-tag', text: 'New' %}
{%- endcomment -%}
{%- if text != blank -%}
  <span class="pattern-tag{% if class != blank %} {{ class }}{% endif %}">
    {{- text | escape -}}
  </span>
{%- endif -%}
