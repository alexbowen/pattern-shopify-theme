{% comment %}
  Renders cart notification ("Added to cart"), restyled for Pattern (assets/pattern-cart.css): paper
  panel, display-font heading, the added record as a cart row with the cart subtotal
  (sections/cart-notification-product.liquid), the Checkout button and quiet View cart / Continue
  shopping links. cart-notification.js is unchanged: Escape and the close buttons close it, focus is
  trapped while it's open.

  Accepts:
  - color_scheme: {String} sets the color scheme of the notification (optional)
  - desktop_menu_type: {String} passes the desktop menu type which allows us to use the right css class (optional)

  Usage:
  {% render 'cart-notification' %}
{% endcomment %}

<cart-notification>
  <div class="cart-notification-wrapper{% if desktop_menu_type != 'drawer' %} page-width{% endif %}">
    <div
      id="cart-notification"
      class="cart-notification pattern-cart-notification focus-inset{% if color_scheme %} color-{{ color_scheme }} gradient{% endif %}"
      aria-modal="true"
      aria-label="{{ 'general.cart.item_added' | t }}"
      role="dialog"
      tabindex="-1"
    >
      <div class="cart-notification__header">
        <h2 class="cart-notification__heading">
          {{ 'general.cart.item_added' | t }}
        </h2>
        <button
          type="button"
          class="cart-notification__close pattern-cart-notification__close"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {%- render 'pattern-icon', name: 'x', size: 24 -%}
        </button>
      </div>
      <div id="cart-notification-product" class="cart-notification-product"></div>
      <div class="cart-notification__links">
        <form action="{{ routes.cart_url }}" method="post" id="cart-notification-form">
          <button class="pattern-button pattern-cart-checkout" name="checkout">
            {{ 'sections.cart.checkout' | t }}
          </button>
        </form>
        <div class="pattern-cart-notification__secondary">
          <a href="{{ routes.cart_url }}" id="cart-notification-button" class="pattern-text-link">
            {{- 'general.cart.view_empty_cart' | t -}}
          </a>
          <button type="button" class="pattern-text-link pattern-cart-notification__continue">{{ 'general.continue_shopping' | t }}</button>
        </div>
      </div>
    </div>
  </div>
</cart-notification>
{% style %}
  .cart-notification {
    display: none;
  }
{% endstyle %}
