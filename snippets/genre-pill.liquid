{% comment %}
  One genre pill: a toggle button (aria-pressed) carrying the filter value in a hidden input.
  The input is disabled while the pill is off, so FormData only includes pressed pills.
  Used by genre-pills.liquid.

  Accepts:
  - value: {Object} Filter value
  - handle: {String} Genre handle, used for the id
  - parent: {String} Parent genre handle, blank for top-level genres
  - is_hidden: {Boolean} Child pill whose parent isn't expanded
  - has_active_child: {Boolean} Parent pill with a selected child
{% endcomment %}
<button
  type="button"
  id="GenrePill-{{ handle }}"
  class="genre-pill{% if parent != blank %} genre-pill--child{% endif %}{% if value.active %} genre-pill--active{% endif %}{% if has_active_child %} genre-pill--has-active-child{% endif %}"
  aria-pressed="{% if value.active %}true{% else %}false{% endif %}"
  data-genre-handle="{{ handle }}"
  {% if parent != blank %}
    data-genre-parent="{{ parent }}"
  {% endif %}
  {% if is_hidden %}
    hidden
  {% endif %}
>
  <span class="genre-pill__label">{{ value.label | escape }}</span>
  <span class="genre-pill__count" aria-hidden="true">{{ value.count }}</span>
  <span class="visually-hidden">
    (
    {%- if value.count == 1 -%}
      {{- 'products.facets.product_count_simple.one' | t: count: value.count -}}
    {%- else -%}
      {{- 'products.facets.product_count_simple.other' | t: count: value.count -}}
    {%- endif -%}
    )
  </span>
  <input
    type="hidden"
    name="{{ value.param_name }}"
    value="{{ value.value }}"
    {% unless value.active %}
      disabled
    {% endunless %}
  >
</button>
