{% comment %}
  Origin filter line under the genre pills: every origin as a small outline pill, ordered by
  product count (highest first) then alphabetically, in a group named "Origin" (no visible label).
  Same row behaviour as the genre pills: one scrolling line on mobile, wrapping from 750px.
  Safety net: past 15 origins, the rest sit behind a small "More" toggle (shown straight away if
  one of them is selected).

  Every visible origin has one hidden input (disabled unless selected): that's what the form
  submits. The pills have no name; facets.js keeps them and the inputs in step, so a value is never
  sent twice. The line sits in the genre pills form, so origin goes with every submission. Shopify
  combines origins with OR and with genres with AND.

  Renders nothing if the filter is missing or has no values with results.

  Accepts:
  - results: {Object} Collection
  - param_name: {String} Param name of the origin filter, e.g. 'filter.p.m.custom.origin'
{% endcomment %}


{%- liquid
  assign origin_filter = results.filters | where: 'param_name', param_name | first
  assign visible = 0
  if origin_filter
    for value in origin_filter.values
      if value.count > 0 or value.active
        assign visible = visible | plus: 1
      endif
    endfor
  endif
-%}

{%- if origin_filter and visible > 0 -%}
  {%- liquid
    assign max_visible = 15

    # Order: count (highest first), then alphabetically within the same count. Zero-count values
    # only appear when selected (so they can be cleared), at the end.
    assign alphabetical = origin_filter.values | sort_natural: 'label'
    assign counts = origin_filter.values | map: 'count' | uniq | sort | reverse

    # Is a selected origin past the threshold? Then the extra pills start open.
    assign extra_active = false
    assign position = 0
    for c in counts
      for value in alphabetical
        if value.count != c
          continue
        endif
        if value.count == 0 and value.active == false
          continue
        endif
        assign position = position | plus: 1
        if position > max_visible and value.active
          assign extra_active = true
        endif
      endfor
    endfor
    assign extra_total = position | minus: max_visible
  -%}

  <div class="origin-line" data-origin-line>
    <div
      class="origin-line__row genre-pills__row"
      data-genre-row="origins"
      role="group"
      aria-label="{{ 'products.facets.origin.chip' | t | escape }}"
    >
      {%- liquid
        # One pass: the first max_visible pills, and the rest for behind "More".
        assign position = 0
        assign visible_html = ''
        assign extra_html = ''
        for c in counts
          for value in alphabetical
            if value.count != c
              continue
            endif
            if value.count == 0 and value.active == false
              continue
            endif
            assign position = position | plus: 1
            assign key = value.value | handleize
            capture pill
              render 'origin-pill', value: value, key: key
            endcapture
            if position > max_visible
              assign extra_html = extra_html | append: pill
            else
              assign visible_html = visible_html | append: pill
            endif
          endfor
        endfor
      -%}
      {{- visible_html -}}
      {%- if extra_total > 0 -%}
        <span class="origin-line__extra" id="OriginLineExtra"{% unless extra_active %} hidden{% endunless %}>
          {{- extra_html -}}
        </span>
        <button
          type="button"
          class="origin-line__more"
          aria-controls="OriginLineExtra"
          aria-expanded="{{ extra_active }}"
          data-origin-more
        >
          <span data-origin-more-label data-more="{{ 'products.facets.origin.more' | t | escape }}" data-less="{{ 'products.facets.origin.less' | t | escape }}">
            {%- if extra_active %}{{ 'products.facets.origin.less' | t }}{% else %}{{ 'products.facets.origin.more' | t }}{% endif -%}
          </span>
        </button>
      {%- endif -%}
      {%- comment -%} Clear: removes the origin values only; shown while an origin is selected. {%- endcomment -%}
      <facet-remove class="origin-line__clear-wrapper"{% if origin_filter.active_values.size == 0 %} hidden{% endif %}>
        <a href="{{ origin_filter.url_to_remove }}" id="OriginClear" class="pattern-clear-link" data-origin-clear>
          {{- 'products.facets.clear' | t -}}
          <span class="visually-hidden">: {{ origin_filter.label | escape }}</span>
        </a>
      </facet-remove>
    </div>

    <div class="origin-line__inputs" hidden>
      {%- for value in origin_filter.values -%}
        {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
        <input
          type="hidden"
          name="{{ value.param_name }}"
          value="{{ value.value }}"
          data-origin-input="{{ value.value | handleize }}"
          {% unless value.active %}
            disabled
          {% endunless %}
        >
      {%- endfor -%}
    </div>
  </div>
  <script>
    (() => {
      // "More" toggle for origins past the threshold. Delegated once, because facets.js
      // re-renders the pills (innerHTML) on every filter change; the open state is kept across
      // those re-renders.
      if (window.patternOriginMoreInit) return;
      window.patternOriginMoreInit = true;
      const setOpen = (button, open) => {
        const extra = document.getElementById(button.getAttribute('aria-controls'));
        const label = button.querySelector('[data-origin-more-label]');
        if (!extra) return;
        extra.hidden = !open;
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (label) label.textContent = open ? label.dataset.less : label.dataset.more;
      };
      document.addEventListener('click', (event) => {
        const button = event.target.closest('[data-origin-more]');
        if (!button) return;
        const open = button.getAttribute('aria-expanded') !== 'true';
        window.patternOriginMoreOpen = open;
        setOpen(button, open);
      });
      const pills = document.querySelector('.genre-pills');
      if (!pills) return;
      new MutationObserver(() => {
        const button = pills.querySelector('[data-origin-more]');
        if (button && window.patternOriginMoreOpen && button.getAttribute('aria-expanded') !== 'true') setOpen(button, true);
      }).observe(pills, { childList: true, subtree: true });
    })();
  </script>
{%- endif -%}
