{% comment %}
  Renders the genre filter as two rows of pills: parent genres, then the children of the
  expanded parents. The inputs are ordinary Shopify filter checkboxes inside a
  facet-filters-form, so facets.js handles the AJAX update like any other filter.

  The genre tree comes from snippets/pattern-genres.liquid (generated from
  pattern-scripts/genres.json). Values are matched to it by label. Labels that aren't in it
  are shown as top-level pills at the end.

  Accepts:
  - results: {Object} Collection object
  - param_name: {String} Param name of the genre filter, e.g. 'filter.p.m.custom.pattern_genre'
  - origin_param: {String} Optional. Param name of the origin filter (e.g. 'filter.p.m.custom.origin');
    rendered as a line under the genre pills by snippets/origin-line.liquid when it has values.
  - header_style: {String} Optional. 'dark': the pills sit in a dark striped band, with the title
    (h1) and record count in a row above them (inside #GenrePills, so facets.js keeps the count
    current). Anything else: the plain pill area.
  - title: {String} Heading for the dark band (e.g. collection.title)
  - description: {String} Optional rich text under the heading in the dark band
  - header_image: {Object} Optional image for the dark band: a cover image (crop from its focal
    point) under an ink overlay, replacing the stripe texture
  - header_overlay: {Number} Overlay strength in percent (default 65)
  - show_sort: {Boolean} Render the record count and sort control (snippets/pattern-sort.liquid).
    False when the Pattern filter bar shows them instead.
    Its select is in this form, so sort_by is submitted with the genres on every filter change.

  Usage:
  {% render 'genre-pills', results: collection, param_name: 'filter.p.m.custom.pattern_genre' %}
{% endcomment %}

{%- comment -%} The search object has no products_count; results_count is its (filtered) total. {%- endcomment -%}
{%- assign results_total = results.products_count | default: results.results_count -%}
{%- liquid
  assign genre_filter = null
  for filter in results.filters
    if filter.param_name == param_name
      assign genre_filter = filter
      break
    endif
  endfor
-%}

{%- if genre_filter -%}
  {%- liquid
    capture genre_map
      render 'pattern-genres'
    endcapture
    assign genre_map = genre_map | strip
    assign entries = genre_map | split: '|'

    # Parents whose children are shown: active parents, plus parents of active children.
    # active_child_parents: parents with a selected child (lighter active state).
    assign expanded = ','
    assign active_child_parents = ','
    for value in genre_filter.active_values
      assign key = '|' | append: value.label | append: '='
      if genre_map contains key
        assign pair = genre_map | split: key | last | split: '|' | first | split: '>'
        if pair[1] != blank
          assign expanded = expanded | append: pair[1] | append: ','
          assign active_child_parents = active_child_parents | append: pair[1] | append: ','
        else
          assign expanded = expanded | append: pair[0] | append: ','
        endif
      endif
    endfor

    assign parents_html = ''
    # Children are grouped into one tray per parent (genres.json lists each parent's children
    # together, right after it). Trays are shown for expanded parents only.
    assign trays_html = ''
    assign tray_html = ''
    assign current_tray = ''
    assign visible_trays = 0
  -%}

  {%- for entry in entries -%}
    {%- if entry == blank -%}{%- continue -%}{%- endif -%}
    {%- liquid
      assign label = entry | split: '=' | first
      assign pair = entry | split: '=' | last | split: '>'
      assign handle = pair[0]
      assign parent = pair[1]
      assign value = genre_filter.values | where: 'label', label | first
      if value == null
        continue
      endif
      # Hide genres with no results here, but keep active ones so they can be deselected.
      if value.count == 0 and value.active == false
        continue
      endif

      assign has_active_child = false
      if parent == blank and value.active == false
        assign handle_key = ',' | append: handle | append: ','
        if active_child_parents contains handle_key
          assign has_active_child = true
        endif
      endif
    -%}
    {%- comment -%} Starting a new parent's children: close the previous tray. {%- endcomment -%}
    {%- if parent != blank and parent != current_tray and current_tray != blank -%}
      {%- capture tray -%}{% render 'genre-tray', parent: current_tray, genre_map: genre_map, expanded: expanded, pills: tray_html %}{%- endcapture -%}
      {%- liquid
        assign trays_html = trays_html | append: tray
        assign tray_key = ',' | append: current_tray | append: ','
        if expanded contains tray_key
          assign visible_trays = visible_trays | plus: 1
        endif
        assign tray_html = ''
      -%}
    {%- endif -%}
    {%- capture pill -%}
      {% render 'genre-pill',
        value: value,
        handle: handle,
        parent: parent,
        is_hidden: false,
        has_active_child: has_active_child
      %}
    {%- endcapture -%}
    {%- liquid
      if parent != blank
        assign current_tray = parent
        assign tray_html = tray_html | append: pill
      else
        assign parents_html = parents_html | append: pill
      endif
    -%}
  {%- endfor -%}
  {%- if current_tray != blank -%}
    {%- capture tray -%}{% render 'genre-tray', parent: current_tray, genre_map: genre_map, expanded: expanded, pills: tray_html %}{%- endcapture -%}
    {%- liquid
      assign trays_html = trays_html | append: tray
      assign tray_key = ',' | append: current_tray | append: ','
      if expanded contains tray_key
        assign visible_trays = visible_trays | plus: 1
      endif
    -%}
  {%- endif -%}

  {%- comment -%} Values not in the genre tree: show as top-level pills so nothing disappears. {%- endcomment -%}
  {%- for value in genre_filter.values -%}
    {%- liquid
      assign key = '|' | append: value.label | append: '='
      if genre_map contains key
        continue
      endif
      if value.count == 0 and value.active == false
        continue
      endif
      assign handle = 'other-' | append: forloop.index
    -%}
    {%- capture pill -%}
      {% render 'genre-pill', value: value, handle: handle, parent: '', is_hidden: false, has_active_child: false %}
    {%- endcapture -%}
    {%- assign parents_html = parents_html | append: pill -%}
  {%- endfor -%}

  {%- if parents_html != blank or trays_html != blank or show_sort -%}
    {%- assign any_active = false -%}
    {%- if genre_filter.active_values.size > 0 -%}{%- assign any_active = true -%}{%- endif -%}
    {{ 'component-genre-pills.css' | asset_url | stylesheet_tag }}
    {%- comment -%} The outer div is the sticky bar (full-width background); content stays in page-width. {%- endcomment -%}
    {%- assign band = false -%}
    {%- if header_style == 'dark' and title != blank -%}{%- assign band = true -%}{%- endif -%}
    {%- liquid
      assign band_image = false
      if band and header_image != blank
        assign band_image = true
        assign band_focal = header_image.presentation.focal_point | default: 'center'
        assign band_image_style = 'object-position: ' | append: band_focal | append: ';'
      endif
    -%}
    <div
      class="genre-pills{% if band %} genre-pills--dark{% if band_image %} genre-pills--image{% else %} pattern-stripe-dark{% endif %}{% endif %}"
      {% if band_image %}
        style="--band-overlay: {{ header_overlay | default: 65 | divided_by: 100.0 }};"
      {% endif %}
    >
      {%- if band_image -%}
        {%- comment -%} Top of the page: loaded eagerly. Absolutely positioned, so it never changes the band's height. {%- endcomment -%}
        <div class="genre-pills__bg" aria-hidden="true">
          {{
            header_image
            | image_url: width: 2000
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              decoding: 'async',
              widths: '750, 1100, 1500, 2000',
              sizes: '100vw',
              alt: '',
              class: 'genre-pills__bg-image',
              style: band_image_style
          }}
        </div>
      {%- endif -%}
      <facet-filters-form class="genre-pills__inner page-width">
        <form id="FacetGenrePillsForm">
          {%- comment -%}
            Search results page: keep the search to products when a filter changes (the filter
            forms carry q and the prefix option; this form is part of every submission).
          {%- endcomment -%}
          {%- if results.terms -%}
            <input type="hidden" name="type" value="product">
          {%- endif -%}
          <div id="GenrePills">
            {%- if band -%}
              <div class="genre-pills__head">
                <h1 class="genre-pills__title">
                  <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
                  {{- title | escape -}}
                </h1>
              </div>
              {%- if description != blank -%}
                <div class="genre-pills__description rte">{{ description }}</div>
              {%- endif -%}
            {%- endif -%}
            <fieldset class="genre-pills__fieldset">
              <legend class="visually-hidden">{{ genre_filter.label | escape }}</legend>
              <div class="genre-pills__top">
                <div class="genre-pills__row genre-pills__row--parents" data-genre-row="parents">
                  <facet-remove class="genre-pills__remove">
                    <a
                      href="{{ genre_filter.url_to_remove }}"
                      id="GenrePill-all"
                      class="genre-pill genre-pill--all{% unless any_active %} genre-pill--active{% endunless %}"
                      aria-pressed="{% if any_active %}false{% else %}true{% endif %}"
                      data-genre-clear
                    >
                      <span class="genre-pill__label">{{ 'products.facets.genre_pills.all' | t }}</span>
                    </a>
                  </facet-remove>
                  {{- parents_html -}}
                  {%- comment -%}
                    Clear: removes the genre values only (url_to_remove keeps the other filters and
                    sort). Rendered always so facets.js can show it the moment a pill is pressed.
                  {%- endcomment -%}
                  <facet-remove class="genre-pills__clear-wrapper"{% unless any_active %} hidden{% endunless %}>
                    <a href="{{ genre_filter.url_to_remove }}" id="GenreClear" class="pattern-clear-link" data-genre-clear>
                      {{- 'products.facets.clear' | t -}}
                      <span class="visually-hidden">: {{ genre_filter.label | escape }}</span>
                    </a>
                  </facet-remove>
                </div>
                {%- if show_sort -%}
                <div class="genre-pills__meta">
                  <p class="genre-pills__count">
                    {{ 'products.facets.genre_pills.records' | t: count: results_total }}
                  </p>
                  {%- if show_sort -%}
                    {%- comment -%} Hidden on mobile, where the copy next to the Filter button drives it. {%- endcomment -%}
                    <div class="genre-pills__sort small-hide">
                      {% render 'pattern-sort', results: results, id: 'PatternSort' %}
                    </div>
                  {%- endif -%}
                </div>
                {%- endif -%}
              </div>
              {%- comment -%} Grid rows 0fr -> 1fr animates the height, so the grid below moves smoothly. {%- endcomment -%}
              <div class="genre-pills__children{% if visible_trays > 0 %} is-open{% endif %}" data-genre-children>
                <div class="genre-pills__children-inner">
                  {{- trays_html -}}
                </div>
              </div>
            </fieldset>
            {%- if origin_param != blank -%}
              {% render 'origin-line', results: results, param_name: origin_param %}
            {%- endif -%}

            {%- comment -%}
              Slim sticky bar: shown (via html.pattern-filters-out, set by the script below) only once
              the filter block has scrolled out of view. Active selections as removable chips
              (facet-remove, so removal is the usual AJAX refresh), a Filters button back to the
              top of the filter block, and a proxy sort control. Inside #GenrePills, which
              facets.js re-renders on every refresh, so it always matches the filters.
            {%- endcomment -%}
            <div class="pattern-filter-sticky" data-pattern-filter-sticky>
              <div class="pattern-filter-sticky__inner page-width">
                <div class="pattern-filter-sticky__chips">
                  {%- assign sticky_chips = 0 -%}
                  {%- for filter in results.filters -%}
                    {%- comment -%} The In stock toggle's paired metafield filter has no chip of its own; the In stock chip removes both (snippets/pattern-in-stock-url.liquid). {%- endcomment -%}
                    {%- if filter.param_name == 'filter.p.m.custom.pattern_availability' -%}{%- continue -%}{%- endif -%}
                    {%- for value in filter.active_values -%}
                      {%- assign sticky_chips = sticky_chips | plus: 1 -%}
                      {%- capture sticky_remove_url -%}{%- if filter.param_name == 'filter.v.availability' -%}{%- render 'pattern-in-stock-url', url: value.url_to_remove -%}{%- else -%}{{ value.url_to_remove }}{%- endif -%}{%- endcapture -%}
                      <facet-remove class="pattern-filter-sticky__chip-wrap">
                        <a href="{{ sticky_remove_url }}" class="pattern-filter-sticky__chip">
                          <span>{{ value.label | escape }}</span>
                          <span class="pattern-filter-sticky__x" aria-hidden="true">×</span>
                          <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}: {{ filter.label | escape }} {{ value.label | escape }}</span>
                        </a>
                      </facet-remove>
                    {%- endfor -%}
                    {%- liquid
                      assign price_active = false
                      if filter.type == 'price_range'
                        if filter.min_value.value != null or filter.max_value.value != null
                          assign price_active = true
                        endif
                      endif
                    -%}
                    {%- if price_active -%}
                      {%- assign sticky_chips = sticky_chips | plus: 1 -%}
                      <facet-remove class="pattern-filter-sticky__chip-wrap">
                        <a href="{{ filter.url_to_remove }}" class="pattern-filter-sticky__chip">
                          <span>{{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}</span>
                          <span class="pattern-filter-sticky__x" aria-hidden="true">×</span>
                          <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                        </a>
                      </facet-remove>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if sticky_chips == 0 -%}
                    <span class="pattern-filter-sticky__none">{{ 'products.facets.genre_pills.records' | t: count: results_total }}</span>
                  {%- endif -%}
                </div>
                <button type="button" class="pattern-filter-sticky__jump" data-pattern-filters-jump>
                  Filters
                </button>
                <div class="pattern-filter-sticky__sort small-hide">
                  {% render 'pattern-sort', results: results, id: 'PatternSortSticky', proxy: true %}
                </div>
              </div>
            </div>
          </div>
        </form>
      </facet-filters-form>
      <script>
        (() => {
          // Show the slim sticky bar only when the whole filter block (genre pills down to the
          // utility row) has scrolled out of view above the viewport.
          if (window.patternFilterStickyInit) return;
          window.patternFilterStickyInit = true;
          const root = document.documentElement;
          const block = document.querySelector('.genre-pills');
          const end = document.getElementById('main-collection-filters') || block;
          if (!block || !end || !('IntersectionObserver' in window)) return;
          const observer = new IntersectionObserver(([entry]) => {
            const out = !entry.isIntersecting && entry.boundingClientRect.bottom < 0;
            root.classList.toggle('pattern-filters-out', out);
          });
          observer.observe(end);
          document.addEventListener('click', (event) => {
            const jump = event.target.closest('[data-pattern-filters-jump]');
            if (!jump) return;
            const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const fromKeyboard = jump.matches(':focus-visible');
            block.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
            // Keyboard users land on the first pill; mouse users keep their place (no stray ring).
            const first = block.querySelector('.genre-pill');
            if (first && fromKeyboard) setTimeout(() => first.focus({ preventScroll: true }), reduce ? 0 : 400);
          });
        })();
      </script>
    </div>
  {%- endif -%}
{%- endif -%}
