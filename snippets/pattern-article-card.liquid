{%- comment -%}
  Pattern article card: cover (hairline outline as on the product cards; the dark stripe texture
  when the post has no image), a DM Mono meta line (date · first tag, or the blog's name when the
  post has no tags), the title in the display font, a clamped excerpt and a "Read" link.
  The title is the only link; it is stretched over the whole card, so the cover and "Read" are
  clickable without extra tab stops. Styles: assets/pattern-blog.css.

  Accepts:
  - article: {Object} article
  - blog_title: {String} shown in the meta line when the post has no tags
  - show_image: {Boolean} default true
  - show_date: {Boolean} default true
  - show_author: {Boolean} default false
  - feature: {Boolean} larger, full-width layout (the blog's "Feature the first post")
  - heading_tag: {String} default 'h2'
  - sizes: {String} image sizes attribute (optional)
  - tag_style: {String} 'meta' (default): first tag in the meta line; 'marker': first tag as a
    small mono marker with the accent square above the title; 'none': no tag
  - show_excerpt: {Boolean} default true
  - excerpt_lines: {Number} 2 or 3 (default 3)
  Without an article (hand-made "story" cards in sections/pattern-editorial-row.liquid), pass the
  fields instead; the card looks the same, and without a url the title isn't a link and there's
  no "Read":
  - title, url, image, tag, excerpt

  Usage:
  {% render 'pattern-article-card', article: article, blog_title: blog.title %}
{%- endcomment -%}
{%- liquid
  assign card_show_image = true
  if show_image == false
    assign card_show_image = false
  endif
  assign card_show_date = true
  if show_date == false
    assign card_show_date = false
  endif
  assign card_tag = heading_tag | default: 'h2'
  assign card_sizes = sizes | default: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
  if feature
    assign card_sizes = '(min-width: 990px) 60vw, 100vw'
  endif

  assign card_tag_style = tag_style | default: 'meta'
  assign card_show_excerpt = true
  if show_excerpt == false
    assign card_show_excerpt = false
  endif

  if article
    assign card_title = article.title
    assign card_url = article.url
    assign card_image = article.image
    assign first_tag = article.tags.first
    assign excerpt = article.excerpt_or_content | strip_html | strip | truncatewords: 40
  else
    assign card_title = title
    assign card_url = url
    assign card_image = image
    assign first_tag = tag
    assign excerpt = excerpt | strip_html | strip | escape
    assign card_show_date = false
  endif

  assign meta_second = ''
  if card_tag_style == 'meta'
    assign meta_second = first_tag | default: blog_title
  endif
  if card_show_excerpt == false
    assign excerpt = ''
  endif
-%}
<article class="pattern-article-card{% if feature %} pattern-article-card--feature{% endif %}{% if excerpt_lines == 2 %} pattern-article-card--excerpt-2{% endif %}">
  {%- if card_show_image -%}
    <div class="pattern-article-card__cover{% if card_image == blank %} pattern-stripe-dark{% endif %}">
      {%- if card_image != blank -%}
        {{
          card_image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '375, 550, 750, 1100, 1600',
            sizes: card_sizes,
            alt: '',
            class: 'pattern-article-card__image'
        }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="pattern-article-card__body">
    {%- if card_tag_style == 'marker' and first_tag != blank -%}
      <p class="pattern-label pattern-article-card__marker">{{ first_tag | escape }}</p>
    {%- endif -%}
    {%- if card_show_date or show_author and article.author != blank or meta_second != blank -%}
    <p class="pattern-label pattern-article-card__meta">
      {%- if card_show_date -%}
        {{- article.published_at | time_tag: format: 'date' -}}
      {%- endif -%}
      {%- if show_author and article.author != blank -%}
        {%- if card_show_date %}<span aria-hidden="true"> · </span>{% endif -%}
        <span>{{ article.author | escape }}</span>
      {%- endif -%}
      {%- if meta_second != blank -%}
        {%- if card_show_date or show_author %}<span aria-hidden="true"> · </span>{% endif -%}
        <span>{{ meta_second | escape }}</span>
      {%- endif -%}
    </p>
    {%- endif -%}
    {%- if card_title != blank -%}
      <{{ card_tag }} class="pattern-article-card__title">
        {%- if card_url != blank -%}
          <a href="{{ card_url }}" class="pattern-article-card__link">{{ card_title | escape }}</a>
        {%- else -%}
          {{- card_title | escape -}}
        {%- endif -%}
      </{{ card_tag }}>
    {%- endif -%}
    {%- if excerpt != blank -%}
      <p class="pattern-article-card__excerpt">{{ excerpt }}</p>
    {%- endif -%}
    {%- if card_url != blank -%}
      <span class="pattern-link pattern-article-card__read" aria-hidden="true">
        {{- 'blogs.article.pattern_read' | t -}}
        {% render 'pattern-arrow' %}
      </span>
    {%- endif -%}
  </div>
</article>
